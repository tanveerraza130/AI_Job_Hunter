<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AI Job Hunter — Section 1 Approved</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#fff;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#171b31}
body{overflow-x:hidden}
.hero{
  width:100%;
  min-height:760px;
  position:relative;
  overflow:hidden;
  background:
    radial-gradient(520px 420px at 74% 49%,rgba(112,72,255,.055),transparent 72%),
    radial-gradient(360px 300px at 91% 48%,rgba(146,112,255,.035),transparent 72%),
    linear-gradient(#fff,#fff);
}
.grid{
  position:absolute;inset:0;pointer-events:none;opacity:.34;
  background-image:
    linear-gradient(rgba(92,75,180,.055) 1px,transparent 1px),
    linear-gradient(90deg,rgba(92,75,180,.055) 1px,transparent 1px);
  background-size:54px 54px;
  mask-image:linear-gradient(to bottom,transparent 0%,black 12%,black 88%,transparent 100%);
}
.wrap{
  position:relative;
  width:min(1500px,calc(100% - 120px));
  min-height:760px;
  margin:auto;
  display:grid;
  grid-template-columns:46.5% 53.5%;
  align-items:center;
  padding:54px 0 42px;
}
.copy{
  position:relative;
  z-index:5;
  padding-left:8px;
  padding-top:2px;
}
.badge{
  display:inline-flex;align-items:center;gap:10px;
  height:42px;padding:0 17px 0 8px;
  border:1px solid #ddd5ff;border-radius:999px;
  background:#fff;box-shadow:0 10px 30px rgba(89,61,220,.08);
  color:#6241e8;font-size:13px;font-weight:750;letter-spacing:.01em
}
.badge-icon{
  width:30px;height:30px;border-radius:50%;display:grid;place-items:center;
  background:#eee9ff;color:#6847ed;font-size:16px
}
h1{
  margin:31px 0 25px;
  max-width:650px;
  font-size:clamp(58px,5.25vw,82px);
  line-height:.98;
  letter-spacing:-.055em;
  font-weight:850;
}
h1 .purple{
  display:block;
  color:#6539ed;
  background:linear-gradient(100deg,#5f3bf1 0%,#7345ee 52%,#a044db 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.desc{
  max-width:650px;margin:0;
  color:#61708a;font-size:19px;line-height:1.62;letter-spacing:-.01em;
}
.ctas{display:flex;gap:20px;margin-top:37px}
.btn{
  height:60px;padding:0 31px;border-radius:13px;
  display:inline-flex;align-items:center;justify-content:center;gap:14px;
  font-size:15px;font-weight:800;text-decoration:none;white-space:nowrap
}
.primary{
  min-width:208px;color:#fff;
  background:linear-gradient(135deg,#653cf0,#5b35e9);
  box-shadow:0 15px 32px rgba(94,58,232,.22)
}
.secondary{
  min-width:242px;color:#6343e7;background:#fff;border:1px solid #ddd6f8;
}
.play{
  width:27px;height:27px;border:1px solid #d9d0ff;border-radius:50%;
  display:grid;place-items:center;font-size:11px;color:#7049ef
}
.sources{margin-top:42px}
.sources-label{font-size:13px;color:#71809a;margin-bottom:16px}
.source-row{display:flex;align-items:center;gap:34px;color:#19243a}
.logo{font-weight:800;font-size:20px;letter-spacing:-.035em;white-space:nowrap}
.naukri,.linkedin,.indeed{color:#0869c9}
.iim{font-size:19px}
.shine{font-size:21px}
.more{color:#78849a;font-size:16px;font-weight:700}

.visual{
  position:relative;
  height:610px;
  min-width:0;
}
.source-panel,.result-panel{
  position:absolute;
  top:93px;
  width:210px;
  height:505px;
  border:1px solid #e4ddf7;
  border-radius:20px;
  background:rgba(255,255,255,.92);
  box-shadow:0 22px 55px rgba(63,45,120,.075);
  z-index:4;
}
.source-panel{left:26px;padding:31px 18px 18px}
.result-panel{right:3px;padding:31px 18px 17px}
.panel-title{
  text-align:center;font-size:18px;line-height:1.18;font-weight:850;
  letter-spacing:-.03em
}
.panel-sub{
  text-align:center;margin-top:14px;color:#8994a9;font-size:12px;line-height:1.42
}
.source-list{margin-top:22px;display:grid;gap:8px}
.source{
  height:47px;border:1px solid #e8e4f2;border-radius:10px;
  display:flex;align-items:center;gap:10px;padding:0 12px;background:#fff;
  box-shadow:0 4px 12px rgba(60,50,100,.035)
}
.source .mark{
  width:27px;height:27px;border-radius:7px;display:grid;place-items:center;
  color:#fff;font-size:12px;font-weight:900
}
.mark.blue{background:#0b73d0}.mark.black{background:#242424}
.source b{font-size:14px;letter-spacing:-.02em}
.more-source{
  justify-content:center;color:#777292;font-size:12px;font-weight:800;
  background:#fcfbff
}

.ai-understands{
  position:absolute;top:1px;left:356px;z-index:6;
  width:154px;
}
.ai-understands h3{
  margin:0 0 14px;color:#6744e8;font-size:18px;font-weight:850;
  letter-spacing:-.025em
}
.checks{display:grid;gap:12px}
.check{display:flex;align-items:center;gap:9px;color:#77839a;font-size:12px}
.check i{
  width:22px;height:22px;border:2px solid #8d6cff;border-radius:50%;
  display:grid;place-items:center;color:#7654f0;font-style:normal;font-size:12px;font-weight:900
}

.ai-core{
  position:absolute;left:328px;top:294px;width:150px;height:150px;z-index:5;
  border-radius:50%;
  background:
    radial-gradient(circle at 50% 40%,#8d64ff 0%,#7043ed 45%,#5b31e5 72%,#5029d8 100%);
  box-shadow:
    0 0 0 17px rgba(112,72,241,.055),
    0 0 0 34px rgba(112,72,241,.025),
    0 22px 48px rgba(93,55,224,.25);
  display:grid;place-items:center;
}
.ai-core:before{
  content:"";position:absolute;inset:14px;border:1px solid rgba(255,255,255,.26);border-radius:50%
}
.spark{
  position:relative;width:54px;height:54px;transform:rotate(45deg)
}
.spark:before,.spark:after{content:"";position:absolute;background:#fff;border-radius:8px}
.spark:before{width:22px;height:54px;left:16px;top:0}
.spark:after{width:54px;height:22px;left:0;top:16px}
.ai-label{
  position:absolute;left:301px;top:456px;width:204px;text-align:center;
  color:#6340e6;font-size:18px;font-weight:850;z-index:6
}
.glow{
  position:absolute;left:270px;top:170px;width:280px;height:280px;border-radius:50%;
  background:radial-gradient(circle,rgba(112,72,241,.13),rgba(112,72,241,.035) 48%,transparent 72%);
  filter:blur(2px)
}

.connectors{position:absolute;inset:0;z-index:3;pointer-events:none}
.connectors svg{width:100%;height:100%;overflow:visible}
.in{
  fill:none;stroke:#9b7cff;stroke-width:2.2;stroke-dasharray:6 8;opacity:.72
}
.out{
  fill:none;stroke:#7954ec;stroke-width:2.5;opacity:.9
}
.dot{fill:#8c6cf6}

.result-panel .panel-sub{margin-bottom:21px}
.jobs{display:grid;gap:9px}
.job{
  position:relative;height:105px;border:1px solid #e8e4f2;border-radius:12px;
  padding:17px 12px 10px 49px;background:#fff;
  box-shadow:0 4px 14px rgba(60,50,100,.035)
}
.rank{
  position:absolute;left:11px;top:17px;width:28px;height:28px;border-radius:7px;
  display:grid;place-items:center;color:#fff;font-size:13px;font-weight:900
}
.rank.r1{background:#1478ce}.rank.r2{background:#ff8c1d}.rank.r3{background:#f04a43}
.job-title{font-size:12px;font-weight:850;line-height:1.2;white-space:nowrap}
.company{margin-top:5px;color:#8290a6;font-size:10px}
.meta{margin-top:6px;color:#8290a6;font-size:9px}
.match{
  position:absolute;right:9px;top:17px;text-align:right;color:#389b75;font-size:16px;font-weight:900
}
.match small{display:block;font-size:8px;margin-top:1px}
.more-jobs{
  height:47px;border:1px solid #e8e4f2;border-radius:10px;
  display:flex;align-items:center;justify-content:space-between;padding:0 14px;
  margin-top:1px;color:#586277;font-size:12px;font-weight:800
}
.more-jobs span:last-child{color:#7650ec;font-size:18px}

@media(max-width:1250px){
  .wrap{width:min(1160px,calc(100% - 56px));grid-template-columns:45% 55%}
  h1{font-size:clamp(52px,5.1vw,68px)}
  .desc{font-size:17px}
  .visual{transform:scale(.9);transform-origin:center right}
}
@media(max-width:900px){
  .hero{min-height:auto}
  .wrap{display:block;width:calc(100% - 32px);padding:65px 0 55px}
  .copy{padding:0;text-align:center}
  .badge{margin:auto}
  h1{font-size:clamp(48px,11vw,68px);max-width:680px;margin:28px auto 22px}
  .desc{margin:auto;font-size:16px;max-width:620px}
  .ctas{justify-content:center;flex-wrap:wrap}
  .sources{text-align:center}
  .source-row{justify-content:center;flex-wrap:wrap;gap:18px 25px}
  .visual{margin:35px auto 0;width:760px;max-width:100%;height:560px;transform:none}
  .source-panel{left:0}.result-panel{right:0}
  .ai-understands{left:50%;transform:translateX(-50%);top:0}
  .ai-core{left:50%;transform:translateX(-50%);top:285px}
  .ai-label{left:50%;transform:translateX(-50%);top:447px}
  .glow{left:50%;transform:translateX(-50%);top:160px}
}
@media(max-width:620px){
  .visual{height:780px;width:100%}
  .source-panel,.result-panel{position:absolute;width:calc(50% - 7px);top:130px;height:485px}
  .source-panel{left:0}.result-panel{right:0}
  .source{height:44px;padding:0 8px}.source b{font-size:11px}
  .source .mark{width:23px;height:23px;font-size:10px}
  .panel-title{font-size:15px}.panel-sub{font-size:10px}
  .ai-understands{top:0;width:150px}
  .ai-core{top:410px;width:120px;height:120px}
  .ai-label{top:535px;font-size:15px}
  .glow{top:320px;width:230px;height:230px}
  .connectors{display:none}
  .job{padding-left:43px}.job-title{font-size:10px}.match{font-size:13px}
  .meta,.company{font-size:8px}
  .ctas{gap:10px}.btn{width:100%;max-width:280px}
}
</style>

