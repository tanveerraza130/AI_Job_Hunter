}

/* ============================================================
   FINAL — WHY IT WORKS INTERNAL CLOSING LINE
   ============================================================ */

@media (min-width: 1181px) {

  .container > .stage > .whyCardFinal > .bottomStatement {

    position: static !important;

    width: 100% !important;

    height: 20px !important;
    min-height: 20px !important;

    margin: 8px 0 0 !important;
    padding: 0 !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    transform: none !important;

    clear: none !important;
  }


  .container > .stage > .whyCardFinal > .bottomStatement p {

    position: static !important;

    width: auto !important;
    height: auto !important;

    margin: 0 !important;
    padding: 0 !important;

    font-size: 11px !important;
    line-height: 1.2 !important;

    font-weight: 500 !important;

    text-align: center !important;

    white-space: nowrap !important;
  }


  .container > .stage > .whyCardFinal > .bottomStatement p strong {

    position: static !important;

    margin: 0 0 0 4px !important;
    padding: 0 !important;

    font-size: 11px !important;
    line-height: 1.2 !important;

    font-weight: 750 !important;

    white-space: nowrap !important;
  }


  .container > .stage > .whyCardFinal > .bottomStatement > span {

    display: block !important;

    width: 34px !important;
    min-width: 34px !important;

    height: 1px !important;

    margin: 0 9px !important;

    opacity: .4 !important;
  }

}

/* ============================================================
   WHY IT WORKS — FINAL SPACING TUNE
   ============================================================ */

@media (min-width: 1181px) {

  /* Move heading slightly upward */
  .container > .stage > .whyCardFinal .whyHeader {
    transform: translateY(-4px) !important;
    margin-bottom: 8px !important;
  }

  /* Move five boxes slightly upward */
  .container > .stage > .whyCardFinal .reasons {
    transform: translateY(-4px) !important;
  }

  /* Closing line stays BELOW the boxes */
  .container > .stage > .whyCardFinal > .bottomStatement {
    margin-top: 5px !important;
    margin-bottom: 0 !important;

    transform: none !important;
  }

  /* Give the section itself breathing room */
  .container > .stage {
    margin-bottom: 32px !important;
  }

}

/* ============================================================
   WHY IT WORKS — REDUCE CARD BOTTOM + ADD NEXT-SECTION GAP
   ============================================================ */

@media (min-width: 1181px) {

  /* Reduce empty space below closing line */
  .container > .stage > .whyCardFinal {
    height: 174px !important;
    min-height: 174px !important;

    padding-bottom: 10px !important;
  }

  /* Keep closing line comfortably inside card */
  .container > .stage > .whyCardFinal > .bottomStatement {
    margin-top: 5px !important;
    height: 18px !important;
    min-height: 18px !important;
  }

  /* More breathing room before next section */
  .container > .stage {
    margin-bottom: 48px !important;
  }
}


/* ============================================================
   SECTION 3 — AI MATCHING
   FINAL APPROVED CENTER DESIGN
   Desktop only
   ============================================================ */

@media (min-width: 1181px) {

  /* ----------------------------------------------------------
     AI AREA
     ---------------------------------------------------------- */

  .container > .stage > .aiArea {

    position: absolute !important;

    left: 50% !important;
    top: 0 !important;

    width: 520px !important;
    height: 100% !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    display: flex !important;

    flex-direction: column !important;

    align-items: center !important;

    overflow: visible !important;

    z-index: 5 !important;
  }


  /* ----------------------------------------------------------
     TEXT / BADGE
     Keep text at top of AI area
     ---------------------------------------------------------- */

  .container > .stage > .aiArea .aiBadge {

    position: absolute !important;

    top: 0 !important;
    left: 50% !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    z-index: 20 !important;

    white-space: nowrap !important;
  }


  .container > .stage > .aiArea > h3 {

    position: absolute !important;

    top: 34px !important;
    left: 50% !important;

    width: max-content !important;
    max-width: 100% !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    text-align: center !important;

    white-space: nowrap !important;

    z-index: 20 !important;
  }


  .container > .stage > .aiArea > p {

    position: absolute !important;

    top: 76px !important;
    left: 50% !important;

    width: 330px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    text-align: center !important;

    z-index: 20 !important;
  }


  /* ----------------------------------------------------------
     AI HALO
     TRUE CENTER OF THE MIDDLE COLUMN
     ---------------------------------------------------------- */

  .container > .stage > .aiArea .aiHalo {

    position: absolute !important;

    left: 50% !important;
    top: 52% !important;

    width: 440px !important;
    height: 440px !important;

    margin: 0 !important;

    transform: translate(-50%, -50%) !important;

    display: block !important;

    overflow: visible !important;

    z-index: 6 !important;
  }


  /* ----------------------------------------------------------
     CONCENTRIC RINGS
     ---------------------------------------------------------- */

  .container > .stage > .aiArea .aiRing {

    position: absolute !important;

    left: 50% !important;
    top: 50% !important;

    margin: 0 !important;

    transform: translate(-50%, -50%) !important;

    border-radius: 50% !important;

    pointer-events: none !important;

    transform-origin: center center !important;

    animation: aiApprovedOrbit 12s linear infinite !important;
  }


  .container > .stage > .aiArea .ringOne {

    width: 300px !important;
    height: 300px !important;
  }


  .container > .stage > .aiArea .ringTwo {

    width: 370px !important;
    height: 370px !important;

    animation-duration: 17s !important;

    animation-direction: reverse !important;
  }


  .container > .stage > .aiArea .ringThree {

    width: 440px !important;
    height: 440px !important;

    animation-duration: 24s !important;
  }


  /* ----------------------------------------------------------
     FLOWING LIGHT TRAILS
     ---------------------------------------------------------- */

  .container > .stage > .aiArea .aiHalo::before {

    content: "" !important;

    position: absolute !important;

    left: -150px !important;
    top: 50% !important;

    width: 740px !important;
    height: 120px !important;

    transform: translateY(-50%) rotate(-7deg) !important;

    border-top: 1px solid rgba(124, 86, 255, .20) !important;
    border-bottom: 1px solid rgba(124, 86, 255, .10) !important;

    border-radius: 50% !important;

    opacity: .9 !important;

    pointer-events: none !important;

    animation: aiFlowTrail 7s ease-in-out infinite !important;
  }


  .container > .stage > .aiArea .aiHalo::after {

    content: "" !important;

    position: absolute !important;

    left: -100px !important;
    top: 50% !important;

    width: 640px !important;
    height: 220px !important;

    transform: translateY(-50%) rotate(8deg) !important;

    border-top: 1px solid rgba(139, 99, 255, .13) !important;

    border-radius: 50% !important;

    pointer-events: none !important;

    animation: aiFlowTrailReverse 10s ease-in-out infinite !important;
  }


  /* ----------------------------------------------------------
     AI CORE
     THIS IS THE IMPORTANT FIX:
     left 50% + top 50% = TRUE CENTER
     ---------------------------------------------------------- */

  .container > .stage > .aiArea .aiCore {

    position: absolute !important;

    left: 50% !important;
    top: 50% !important;

    width: 220px !important;
    height: 220px !important;

    margin: 0 !important;

    transform: translate(-50%, -50%) !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    border-radius: 50% !important;

    z-index: 15 !important;

    transform-origin: center center !important;

    animation:
      aiCoreFloat 4.8s ease-in-out infinite,
      aiCoreGlow 4.8s ease-in-out infinite !important;
  }


  /* Keep inner glow centered too */

  .container > .stage > .aiArea .aiCore::before {

    left: 50% !important;
    top: 50% !important;

    transform: translate(-50%, -50%) !important;

    border-radius: 50% !important;
  }


  /* ----------------------------------------------------------
     SPARK
     ---------------------------------------------------------- */

  .container > .stage > .aiArea .aiSpark {

    position: absolute !important;

    left: 50% !important;
    top: 50% !important;

    margin: 0 !important;

    transform: translate(-50%, -50%) !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;
    height: 100% !important;

    z-index: 20 !important;

    animation: aiSparkPulse 3.2s ease-in-out infinite !important;
  }


  /* ----------------------------------------------------------
     SIGNAL PILLS
     ---------------------------------------------------------- */

  .container > .stage > .aiArea .aiSignals {

    position: absolute !important;

    left: 50% !important;
    bottom: 0 !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 8px !important;

    z-index: 20 !important;
  }


  /* ----------------------------------------------------------
     MOTION
     ---------------------------------------------------------- */

  @keyframes aiApprovedOrbit {

    0% {
      transform:
        translate(-50%, -50%)
        rotate(0deg);
    }

    50% {
      transform:
        translate(-50%, -50%)
        rotate(180deg);
    }

    100% {
      transform:
        translate(-50%, -50%)
        rotate(360deg);
    }

  }


  @keyframes aiCoreFloat {

    0%,
    100% {
      transform:
        translate(-50%, -50%)
        scale(1);
    }

    50% {
      transform:
        translate(-50%, calc(-50% - 5px))
        scale(1.025);
    }

  }


  @keyframes aiCoreGlow {

    0%,
    100% {
      filter:
        drop-shadow(0 16px 28px rgba(111, 72, 240, .20));
    }

    50% {
      filter:
        drop-shadow(0 22px 42px rgba(111, 72, 240, .34));
    }

  }


  @keyframes aiSparkPulse {

    0%,
    100% {
      opacity: .92;
      transform:
        translate(-50%, -50%)
        scale(1);
    }

    50% {
      opacity: 1;
      transform:
        translate(-50%, -50%)
        scale(1.08);
    }

  }


  @keyframes aiFlowTrail {

    0%,
    100% {
      opacity: .35;

      transform:
        translateY(-50%)
        translateX(-18px)
        rotate(-7deg);
    }

    50% {
      opacity: .85;

      transform:
        translateY(-50%)
        translateX(18px)
        rotate(-5deg);
    }

  }


  @keyframes aiFlowTrailReverse {

    0%,
    100% {
      opacity: .20;

      transform:
        translateY(-50%)
        translateX(20px)
        rotate(8deg);
    }

    50% {
      opacity: .65;

      transform:
        translateY(-50%)
        translateX(-20px)
        rotate(6deg);
    }

  }

}


/* ------------------------------------------------------------
   REDUCED MOTION
   ------------------------------------------------------------ */

@media (prefers-reduced-motion: reduce) {

  .container > .stage > .aiArea .aiRing,
  .container > .stage > .aiArea .aiCore,
  .container > .stage > .aiArea .aiSpark,
  .container > .stage > .aiArea .aiHalo::before,
  .container > .stage > .aiArea .aiHalo::after {

    animation: none !important;
  }

}

