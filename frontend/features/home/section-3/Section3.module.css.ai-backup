   ============================================================ */

@media (min-width: 1181px) {

  /* Main profile card */
  .profilePanel {
    width: 340px !important;
    height: 430px !important;

    padding: 30px 28px 24px !important;

    box-sizing: border-box !important;

    display: flex !important;
    flex-direction: column !important;

    overflow: visible !important;
  }


  /* Top eyebrow */
  .profilePanel > :first-child {
    margin-top: 0 !important;
  }


  /* Profile title */
  .profilePanel h3 {
    margin-top: 10px !important;
    margin-bottom: 26px !important;

    line-height: 1.1 !important;
  }


  /* Identity / CRM Manager area */
  .profilePanel .profileIdentity,
  .profilePanel .identity,
  .profilePanel .profileInfo,
  .profilePanel .userInfo {
    display: flex !important;
    align-items: center !important;

    min-height: 78px !important;

    margin-bottom: 24px !important;
  }


  /* Avatar */
  .profilePanel .avatar,
  .profilePanel .profileAvatar,
  .profilePanel .userAvatar {
    flex: 0 0 auto !important;

    width: 54px !important;
    height: 54px !important;

    margin-right: 16px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }


  /* CRM Manager title */
  .profilePanel .profileIdentity strong,
  .profilePanel .identity strong,
  .profilePanel .profileInfo strong,
  .profilePanel .userInfo strong {
    display: block !important;

    margin: 0 !important;

    font-size: 17px !important;

    line-height: 1.2 !important;
  }


  /* Career profile */
  .profilePanel .profileIdentity small,
  .profilePanel .identity small,
  .profilePanel .profileInfo small,
  .profilePanel .userInfo small {
    display: block !important;

    margin-top: 6px !important;

    font-size: 11px !important;

    line-height: 1.2 !important;
  }


  /* Divider */
  .profilePanel hr {
    width: 100% !important;

    margin:
      0
      0
      18px !important;

    border: 0 !important;

    border-top:
      1px solid rgba(65, 55, 120, .10) !important;
  }


  /* Profile item wrapper */
  .profilePanel .profileItems,
  .profilePanel .items,
  .profilePanel .profileList,
  .profilePanel .details {
    display: flex !important;

    flex-direction: column !important;

    gap: 10px !important;

    width: 100% !important;

    margin: 0 !important;
  }


  /* Each Skills / Experience / Preferences card */
  .profilePanel .profileItem,
  .profilePanel .item,
  .profilePanel .profileRow,
  .profilePanel .detailItem {
    width: 100% !important;

    min-height: 58px !important;

    height: 58px !important;

    padding:
      10px
      13px !important;

    box-sizing: border-box !important;

    display: flex !important;

    align-items: center !important;

    gap: 12px !important;

    margin: 0 !important;

    border-radius: 14px !important;
  }


  /* Inner icon */
  .profilePanel .profileItem .icon,
  .profilePanel .item .icon,
  .profilePanel .profileRow .icon,
  .profilePanel .detailItem .icon {
    flex: 0 0 38px !important;

    width: 38px !important;
    height: 38px !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    margin: 0 !important;
  }


  /* Text container */
  .profilePanel .profileItem .content,
  .profilePanel .item .content,
  .profilePanel .profileRow .content,
  .profilePanel .detailItem .content {
    flex: 1 1 auto !important;

    min-width: 0 !important;

    display: flex !important;

    flex-direction: column !important;

    justify-content: center !important;

    gap: 4px !important;
  }


  /* Item title */
  .profilePanel .profileItem strong,
  .profilePanel .item strong,
  .profilePanel .profileRow strong,
  .profilePanel .detailItem strong {
    margin: 0 !important;

    font-size: 12px !important;

    line-height: 1.2 !important;

    font-weight: 700 !important;
  }


  /* Item subtitle */
  .profilePanel .profileItem small,
  .profilePanel .item small,
  .profilePanel .profileRow small,
  .profilePanel .detailItem small {
    margin: 0 !important;

    font-size: 9px !important;

    line-height: 1.25 !important;
  }


  /* Check mark */
  .profilePanel .check,
  .profilePanel .checkmark,
  .profilePanel .verified {
    flex: 0 0 auto !important;

    margin-left: auto !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    width: 18px !important;
    height: 18px !important;
  }


  /* Profile strength */
  .profilePanel .profileStrength,
  .profilePanel .strength,
  .profilePanel .profile-strength {

    position: absolute !important;

    left: 28px !important;
    right: 28px !important;

    bottom: -58px !important;

    margin: 0 !important;

    padding: 0 !important;

    box-sizing: border-box !important;
  }


  /* Strength label row */
  .profilePanel .profileStrength > div:first-child,
  .profilePanel .strength > div:first-child,
  .profilePanel .profile-strength > div:first-child {
    display: flex !important;

    align-items: center !important;
    justify-content: space-between !important;

    margin-bottom: 9px !important;
  }


  /* Strength text */
  .profilePanel .profileStrength span,
  .profilePanel .strength span,
  .profilePanel .profile-strength span {
    line-height: 1.2 !important;
  }


  /* Strength bar */
  .profilePanel .profileStrength .bar,
  .profilePanel .strength .bar,
  .profilePanel .profile-strength .bar,
  .profilePanel .strengthBar {

    width: 100% !important;

    height: 6px !important;

    border-radius: 999px !important;

    overflow: hidden !important;
  }

}


