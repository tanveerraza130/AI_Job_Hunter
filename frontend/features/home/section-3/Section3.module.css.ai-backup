/* =========================================================
   AI JOB HUNTER — SECTION 3
   ONE PROFILE. EVERY RELEVANT OPPORTUNITY.
   Fully isolated.
   ========================================================= */

.section {
  position: relative;
  isolation: isolate;
  overflow: hidden;

  min-height: 900px;

  padding: 112px 0 96px;

  background:
    linear-gradient(
      180deg,
      #fbfaff 0%,
      #f7f5ff 48%,
      #fbfaff 100%
    );

  color: #15162a;
}

.background {
  position: absolute;
  inset: 0;

  pointer-events: none;

  overflow: hidden;
}

.grid {
  position: absolute;
  inset: 0;

  opacity: .36;

  background-image:
    linear-gradient(
      rgba(113, 82, 220, .045) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(113, 82, 220, .045) 1px,
      transparent 1px
    );

  background-size: 72px 72px;

  mask-image:
    linear-gradient(
      to bottom,
      transparent,
      black 18%,
      black 82%,
      transparent
    );
}

.glowOne,
.glowTwo {
  position: absolute;

  border-radius: 50%;

  filter: blur(2px);
}

.glowOne {
  width: 520px;
  height: 520px;

  left: -260px;
  top: 260px;

  background:
    radial-gradient(
      circle,
      rgba(119, 78, 239, .09),
      transparent 68%
    );

  animation:
    ambientOne 9s ease-in-out infinite;
}

.glowTwo {
  width: 600px;
  height: 600px;

  right: -300px;
  top: 80px;

  background:
    radial-gradient(
      circle,
      rgba(143, 107, 255, .10),
      transparent 68%
    );

  animation:
    ambientTwo 11s ease-in-out infinite;
}

.orbit {
  position: absolute;

  left: 50%;
  top: 52%;

  border:
    1px solid rgba(121, 85, 231, .065);

  border-radius: 50%;

  transform:
    translate(-50%, -50%)
    rotate(-8deg);
}

.orbitOne {
  width: 950px;
  height: 390px;

  animation:
    orbitFloat 12s ease-in-out infinite;
}

.orbitTwo {
  width: 1250px;
  height: 530px;

  opacity: .65;

  animation:
    orbitFloat 16s ease-in-out infinite reverse;
}

/* =========================================================
   CONTAINER
   ========================================================= */

.container {
  position: relative;
  z-index: 2;

  width: min(1360px, calc(100% - 72px));

  margin: 0 auto;
}

/* =========================================================
   HEADER
   ========================================================= */

.header {
  max-width: 760px;

  margin: 0 auto 74px;

  text-align: center;
}

.eyebrow {
  display: inline-flex;

  align-items: center;
  gap: 9px;

  margin-bottom: 18px;

  color: #7650e9;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .16em;
  text-transform: uppercase;
}

.eyebrowDot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #7650e9;

  box-shadow:
    0 0 0 5px rgba(118, 80, 233, .08),
    0 0 14px rgba(118, 80, 233, .30);

  animation:
    eyebrowPulse 3s ease-in-out infinite;
}

.header h2 {
  margin: 0;

  color: #17182c;

  font-size: clamp(42px, 4.1vw, 66px);

  font-weight: 850;

  line-height: .98;

  letter-spacing: -.055em;
}

.header h2 span {
  color: #7045e8;
}

.header p {
  max-width: 590px;

  margin: 22px auto 0;

  color: #74788f;

  font-size: 14px;

  line-height: 1.7;

  letter-spacing: -.01em;
}

/* =========================================================
   MAIN STAGE
   ========================================================= */

.stage {
  position: relative;

  min-height: 520px;

  display: grid;

  grid-template-columns:
    minmax(260px, 315px)
    minmax(270px, 330px)
    minmax(260px, 315px);

  align-items: center;

  justify-content: center;

  column-gap: 76px;
}

/* =========================================================
   PANELS
   ========================================================= */

.panel {
  position: relative;

  border:
    1px solid rgba(112, 79, 226, .13);

  border-radius: 24px;

  background:
    rgba(255,255,255,.86);

  box-shadow:
    0 24px 70px rgba(75, 49, 151, .08),
    0 4px 15px rgba(75, 49, 151, .035);

  backdrop-filter: blur(14px);

  transition:
    transform .45s cubic-bezier(.22,.8,.28,1),
    box-shadow .45s ease,
    border-color .45s ease;
}

.panel:hover {
  transform: translateY(-5px);

  border-color:
    rgba(112, 79, 226, .22);

  box-shadow:
    0 30px 85px rgba(75, 49, 151, .13),
    0 8px 20px rgba(75, 49, 151, .05);
}

.profilePanel,
.matchesPanel {
  min-height: 430px;

  padding: 25px;
}

/* =========================================================
   PANEL HEADER
   ========================================================= */

.panelTop {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;
}

.panelKicker {
  display: block;

  margin-bottom: 7px;

  color: #948fa8;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .15em;
}

.panelTop h3 {
  margin: 0;

  color: #1b1c31;

  font-size: 18px;

  font-weight: 820;

  letter-spacing: -.035em;
}

.active,
.live {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 6px 9px;

  border-radius: 999px;

  background: rgba(66, 180, 119, .07);

  color: #38a36d;

  font-size: 8px;

  font-weight: 750;
}

.active i,
.live i {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #47bb7d;

  box-shadow:
    0 0 8px rgba(71, 187, 125, .5);

  animation:
    statusPulse 2.4s ease-in-out infinite;
}

/* =========================================================
   PROFILE
   ========================================================= */

.role {
  display: flex;

  align-items: center;

  gap: 12px;

  margin-top: 26px;

  padding-bottom: 19px;

  border-bottom:
    1px solid rgba(31, 30, 52, .06);
}

.avatar {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border-radius: 13px;

  background:
    linear-gradient(
      145deg,
      #8964fa,
      #6136df
    );

  color: white;

  font-size: 15px;

  font-weight: 800;

  box-shadow:
    0 8px 20px rgba(99, 56, 220, .20);
}

.role div:last-child {
  display: flex;

  flex-direction: column;
}

.role strong {
  color: #202139;

  font-size: 13px;

  font-weight: 800;
}

.role span {
  margin-top: 4px;

  color: #9290a3;

  font-size: 9px;
}

.profileList {
  display: flex;

  flex-direction: column;

  gap: 8px;

  margin-top: 18px;
}

.profileItem {
  display: flex;

  align-items: center;

  min-height: 55px;

  padding: 9px 10px;

  border:
    1px solid rgba(97, 69, 194, .075);

  border-radius: 13px;

  background:
    rgba(250,249,255,.8);

  transition:
    transform .3s ease,
    border-color .3s ease,
    background .3s ease;
}

.profileItem:hover {
  transform: translateX(3px);

  border-color:
    rgba(112, 79, 226, .18);

  background: #fff;
}

.profileIcon {
  width: 29px;
  height: 29px;

  display: grid;
  place-items: center;

  flex: 0 0 29px;

  border-radius: 9px;

  background:
    rgba(112, 74, 231, .09);

  color: #7650e9;

  font-size: 11px;
}

.profileCopy {
  min-width: 0;

  display: flex;

  flex-direction: column;

  margin-left: 10px;
}

.profileCopy strong {
  color: #34354a;

  font-size: 9px;

  font-weight: 760;
}

.profileCopy small {
  margin-top: 4px;

  overflow: hidden;

  color: #9693a6;

  font-size: 8px;

  white-space: nowrap;

  text-overflow: ellipsis;
}

.check {
  margin-left: auto;

  color: #4eae7a;

  font-size: 12px;

  font-weight: 800;
}

.profileFooter {
  position: relative;

  margin-top: 20px;

  padding-top: 17px;

  border-top:
    1px solid rgba(31, 30, 52, .06);

  color: #9290a2;

  font-size: 8px;
}

.profileFooter strong {
  float: right;

  color: #7650e9;

  font-size: 10px;
}

.progress {
  clear: both;

  height: 5px;

  margin-top: 10px;

  overflow: hidden;

  border-radius: 999px;

  background: #eeebf7;
}

.progress i {
  display: block;

  width: 92%;
  height: 100%;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      #9a7bff,
      #673ce5
    );

  transform-origin: left;

  animation:
    progressGrow 2s ease-out both,
    progressBreath 4s ease-in-out 2s infinite;
}

/* =========================================================
   AI AREA
   ========================================================= */

.aiArea {
  position: relative;

  min-height: 470px;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;
}

.aiHalo {
  position: relative;

  width: 215px;
  height: 215px;

  display: grid;
  place-items: center;
}

.aiRing {
  position: absolute;

  inset: 0;

  border:
    1px solid rgba(118, 80, 233, .13);

  border-radius: 50%;
}

.ringOne {
  transform: scale(1);

  animation:
    aiOrbitOne 8s linear infinite;
}

.ringTwo {
  inset: 16px;

  border-color:
    rgba(118, 80, 233, .17);

  animation:
    aiOrbitTwo 6s linear infinite reverse;
}

.ringThree {
  inset: 33px;

  border:
    1px dashed rgba(118, 80, 233, .20);

  animation:
    aiOrbitThree 10s linear infinite;
}

.aiCore {
  position: relative;

  width: 116px;
  height: 116px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 38% 28%,
      #9270ff 0%,
      #7549ed 42%,
      #5b31d8 100%
    );

  border:
    1px solid rgba(255,255,255,.5);

  box-shadow:
    inset 0 1px 1px rgba(255,255,255,.42),
    inset 0 -12px 25px rgba(44, 17, 129, .20),
    0 25px 60px rgba(93, 47, 218, .28),
    0 0 80px rgba(117, 76, 237, .17);

  animation:
    aiCoreBreath 4.5s ease-in-out infinite;
}

.aiCore::before {
  content: "";

  position: absolute;

  inset: 10px;

  border:
    1px solid rgba(255,255,255,.20);

  border-radius: 50%;
}

.aiSpark {
  position: relative;
  z-index: 2;

  color: #fff;

  font-size: 45px;

  line-height: 1;

  text-shadow:
    0 0 20px rgba(255,255,255,.45);

  animation:
    sparkFloat 3.4s ease-in-out infinite;
}

.aiBadge {
  display: inline-flex;

  align-items: center;

  gap: 7px;

  margin-top: 14px;

  color: #7650e9;

  font-size: 9px;

  font-weight: 850;

  letter-spacing: .14em;
}

.aiBadge span {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #7650e9;

  box-shadow:
    0 0 9px rgba(118, 80, 233, .65);
}

.aiArea h3 {
  margin: 11px 0 0;

  color: #25263b;

  font-size: 15px;

  font-weight: 800;

  letter-spacing: -.025em;
}

.aiArea > p {
  margin: 7px 0 0;

  color: #9290a4;

  font-size: 9px;

  line-height: 1.55;
}

.aiSignals {
  display: flex;

  align-items: center;

  gap: 5px;

  margin-top: 15px;
}

.aiSignals span {
  padding: 5px 8px;

  border:
    1px solid rgba(112, 79, 226, .10);

  border-radius: 999px;

  background:
    rgba(255,255,255,.65);

  color: #9995aa;

  font-size: 7px;

  font-weight: 700;
}

/* =========================================================
   CONNECTORS
   ========================================================= */

.connector {
  position: absolute;

  top: 50%;

  width: 105px;
  height: 70px;

  pointer-events: none;

  transform: translateY(-50%);
}

.connectorLeft {
  left: calc(50% - 388px);
}

.connectorRight {
  right: calc(50% - 388px);
}

.connectorLine {
  position: absolute;

  top: 50%;

  width: 100%;
  height: 2px;

  transform: translateY(-50%);

  background:
    repeating-linear-gradient(
      90deg,
      rgba(121, 83, 234, .42) 0 8px,
      transparent 8px 15px
    );

  mask-image:
    linear-gradient(
      90deg,
      transparent,
      black 18%,
      black 82%,
      transparent
    );
}

.connectorRight .connectorLine {
  transform:
    translateY(-50%)
    scaleX(-1);
}

.connector i {
  position: absolute;

  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #8a66f6;

  box-shadow:
    0 0 10px rgba(117, 75, 239, .65);
}

.particleOne {
  top: 24px;

  animation:
    connectorTravel 2.8s linear infinite;
}

.particleTwo {
  top: 33px;

  animation:
    connectorTravel 2.8s linear .9s infinite;
}

.particleThree {
  top: 43px;

  animation:
    connectorTravel 2.8s linear 1.8s infinite;
}

/* =========================================================
   MATCHES
   ========================================================= */

.matchesPanel {
  padding-bottom: 20px;
}

.matchList {
  display: flex;

  flex-direction: column;

  gap: 8px;

  margin-top: 24px;
}

.matchCard {
  position: relative;

  min-height: 83px;

  padding: 13px 12px 11px 15px;

  border:
    1px solid rgba(76, 69, 108, .07);

  border-radius: 14px;

  background: #fcfbff;

  overflow: hidden;

  transition:
    transform .35s ease,
    box-shadow .35s ease;
}

.matchCard:hover {
  transform: translateX(-3px);

  box-shadow:
    0 10px 24px rgba(71, 48, 142, .08);
}

.matchCard::before {
  content: "";

  position: absolute;

  left: 0;
  top: 0;
  bottom: 0;

  width: 3px;

  background: #7650e9;

  opacity: .7;
}

.matchCard.strong::before {
  background: #4f9be8;
}

.matchCard.good::before {
  background: #58ae87;
}

.matchScore {
  display: flex;

  align-items: baseline;

  gap: 5px;
}

.matchScore strong {
  color: #39a274;

  font-size: 16px;

  font-weight: 850;

  letter-spacing: -.04em;
}

.matchCard.strong .matchScore strong {
  color: #4c91dc;
}

.matchCard.good .matchScore strong {
  color: #5ca47d;
}

.matchScore span {
  color: #9a97a9;

  font-size: 7px;

  font-weight: 700;
}

.matchInfo {
  display: flex;

  flex-direction: column;

  margin-top: 5px;

  padding-right: 30px;
}

.matchInfo strong {
  color: #303145;

  font-size: 9px;

  font-weight: 800;

  line-height: 1.25;
}

.matchInfo span {
  margin-top: 4px;

  color: #9996a9;

  font-size: 7px;
}

.matchRank {
  position: absolute;

  top: 12px;
  right: 12px;

  color: #d2cede;

  font-size: 8px;

  font-weight: 800;
}

.moreMatches {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-top: 10px;

  padding: 10px 11px;

  border:
    1px dashed rgba(112, 79, 226, .14);

  border-radius: 11px;

  color: #8d899d;

  font-size: 8px;

  font-weight: 650;
}

.moreMatches b {
  color: #7650e9;

  font-size: 12px;
}

/* =========================================================
   WHY IT WORKS
   ========================================================= */

.whyCard {
  position: absolute;

  left: 50%;

  bottom: -76px;

  width: min(650px, calc(100% - 80px));

  padding: 19px 21px;

  border:
    1px solid rgba(112, 79, 226, .11);

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.90),
      rgba(248,246,255,.92)
    );

  box-shadow:
    0 18px 50px rgba(73, 46, 148, .07);

  transform: translateX(-50%);

  backdrop-filter: blur(12px);
}

.whyHeader {
  display: flex;

  align-items: center;

  gap: 11px;
}

.whyIcon {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  background:
    rgba(112, 74, 231, .09);

  color: #7650e9;

  font-size: 14px;
}

.whyHeader > div {
  display: flex;

  flex-direction: column;
}

.whyHeader > div > span {
  color: #9a96a8;

  font-size: 7px;

  font-weight: 800;

  letter-spacing: .13em;
}

.whyHeader h3 {
  margin: 4px 0 0;

  color: #25263b;

  font-size: 12px;

  font-weight: 800;
}

.reasons {
  display: grid;

  grid-template-columns:
    repeat(5, 1fr);

  gap: 8px;

  margin-top: 16px;
}

.reason {
  display: grid;

  grid-template-columns: auto 1fr auto;

  align-items: center;

  gap: 7px;

  min-width: 0;

  padding: 9px 8px;

  border:
    1px solid rgba(71, 66, 93, .055);

  border-radius: 9px;

  background: rgba(255,255,255,.56);
}

.reason > span {
  color: #aaa5b7;

  font-size: 7px;

  font-weight: 800;
}

.reason strong {
  overflow: hidden;

  color: #666376;

  font-size: 7px;

  font-weight: 700;

  line-height: 1.25;

  text-overflow: ellipsis;
}

.reason i {
  color: #4caf7e;

  font-size: 9px;

  font-style: normal;

  font-weight: 800;
}

.whyFooter {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 5px;

  margin-top: 13px;

  color: #aaa5b5;

  font-size: 8px;
}

.whyFooter strong {
  color: #7650e9;

  font-weight: 800;
}


/* =========================================================
   MOTION
   ========================================================= */

@keyframes eyebrowPulse {
  0%, 100% {
    opacity: .55;
    transform: scale(.9);
  }

  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}

@keyframes statusPulse {
  0%, 100% {
    opacity: .4;
    transform: scale(.8);
  }

  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}

@keyframes ambientOne {
  0%, 100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(50px, -35px);
  }
}

@keyframes ambientTwo {
  0%, 100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(-55px, 40px);
  }
}

@keyframes orbitFloat {
  0%, 100% {
    transform:
      translate(-50%, -50%)
      rotate(-8deg)
      scale(1);
  }

  50% {
    transform:
      translate(-50%, -50%)
      rotate(-4deg)
      scale(1.025);
  }
}

@keyframes aiOrbitOne {
  to {
    transform: rotate(360deg);
  }
}

@keyframes aiOrbitTwo {
  to {
    transform: rotate(-360deg);
  }
}

@keyframes aiOrbitThree {
  to {
    transform: rotate(360deg);
  }
}

@keyframes aiCoreBreath {
  0%, 100% {
    transform: scale(1);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.42),
      inset 0 -12px 25px rgba(44, 17, 129, .20),
      0 25px 60px rgba(93, 47, 218, .28),
      0 0 80px rgba(117, 76, 237, .17);
  }

  50% {
    transform: scale(1.035);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.42),
      inset 0 -12px 25px rgba(44, 17, 129, .20),
      0 28px 68px rgba(93, 47, 218, .34),
      0 0 105px rgba(117, 76, 237, .24);
  }
}

@keyframes sparkFloat {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }

  50% {
    transform: translateY(-4px) rotate(4deg);
  }
}

@keyframes connectorTravel {
  0% {
    left: 0;
    opacity: 0;
    transform: scale(.65);
  }

  15% {
    opacity: 1;
  }

  85% {
    opacity: .8;
  }

  100% {
    left: 100%;
    opacity: 0;
    transform: scale(1);
  }
}

@keyframes progressGrow {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}

@keyframes progressBreath {
  0%, 100% {
    filter: brightness(1);
  }

  50% {
    filter: brightness(1.12);
  }
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1180px) {

  .container {
    width: min(1000px, calc(100% - 48px));
  }

  .stage {
    grid-template-columns:
      minmax(220px, 275px)
      minmax(230px, 280px)
      minmax(220px, 275px);

    column-gap: 42px;
  }

  .connector {
    display: none;
  }

  .whyCard {
    bottom: -70px;
  }

  .reasons {
    grid-template-columns:
      repeat(3, 1fr);
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {

  .section {
    min-height: auto;

    padding:
      78px 0 72px;
  }

  .container {
    width: calc(100% - 34px);
  }

  .header {
    margin-bottom: 48px;
  }

  .header h2 {
    font-size: clamp(36px, 10vw, 52px);
    line-height: 1;
  }

  .header p {
    margin-top: 17px;

    font-size: 13px;
  }

  .stage {
    min-height: auto;

    display: flex;

    flex-direction: column;

    gap: 26px;
  }

  .profilePanel,
  .matchesPanel {
    width: 100%;

    min-height: auto;

    padding: 22px;
  }

  .aiArea {
    min-height: 350px;
  }

  .aiHalo {
    width: 190px;
    height: 190px;
  }

  .aiCore {
    width: 104px;
    height: 104px;
  }

  .aiSpark {
    font-size: 40px;
  }

  .whyCard {
    position: relative;

    left: auto;
    bottom: auto;

    width: 100%;

    margin-top: 0;

    transform: none;
  }

  .reasons {
    grid-template-columns:
      repeat(2, 1fr);
  }


}

/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 480px) {

  .section {
    padding:
      64px 0 58px;
  }

  .container {
    width: calc(100% - 28px);
  }

  .header {
    margin-bottom: 38px;
  }

  .header h2 {
    font-size: 36px;
  }

  .header p {
    font-size: 12px;
    line-height: 1.65;
  }

  .profilePanel,
  .matchesPanel {
    padding: 18px;
  }

  .role {
    margin-top: 20px;
  }

  .profileItem {
    min-height: 51px;
  }

  .aiArea {
    min-height: 315px;
  }

  .aiSignals {
    flex-wrap: wrap;
    justify-content: center;

    max-width: 240px;
  }

  .reasons {
    grid-template-columns: 1fr;
  }

  .reason {
    padding: 10px;
  }


}

/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .glowOne,
  .glowTwo,
  .orbitOne,
  .orbitTwo,
  .eyebrowDot,
  .active i,
  .live i,
  .progress i,
  .aiRing,
  .aiCore,
  .aiSpark,
  .connector i {
    animation: none !important;
  }

  .panel,
  .profileItem,
  .matchCard {
    transition: none !important;
  }
}

/* =========================================================
   SECTION 3 — FINAL DESKTOP COMPOSITION FIX
   Visual alignment only.
   Section 1 / 2 / 6 / Footer untouched.
   ========================================================= */

@media (min-width: 1181px) {

  .section {
    padding-top: 105px;
    padding-bottom: 110px;
  }

  .container {
    width: min(1280px, calc(100% - 80px));
  }

  .header {
    margin-bottom: 58px;
  }

  .header h2 {
    font-size: clamp(48px, 4vw, 62px);
  }

  .header p {
    font-size: 14px;
    max-width: 620px;
  }

  /* -------------------------------------------------------
     MAIN 3-COLUMN COMPOSITION
     ------------------------------------------------------- */

  .stage {
    width: 1080px;
    max-width: 100%;

    min-height: 500px;

    margin: 0 auto;

    display: grid;

    grid-template-columns:
      320px
      300px
      320px;

    column-gap: 70px;

    align-items: center;

    justify-content: center;
  }

  /* -------------------------------------------------------
     LEFT / RIGHT CARDS
     ------------------------------------------------------- */

  .profilePanel,
  .matchesPanel {
    width: 320px;

    min-height: 405px;

    padding: 25px;
  }

  .profilePanel {
    grid-column: 1;
    grid-row: 1;
  }

  .aiArea {
    grid-column: 2;
    grid-row: 1;

    width: 300px;
    min-height: 405px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding-top: 4px;
  }

  .matchesPanel {
    grid-column: 3;
    grid-row: 1;
  }

  /* -------------------------------------------------------
     AI CORE — MAKE IT THE VISUAL ANCHOR
     ------------------------------------------------------- */

  .aiHalo {
    width: 225px;
    height: 225px;

    margin: 0 auto;
  }

  .aiCore {
    width: 124px;
    height: 124px;
  }

  .aiSpark {
    font-size: 48px;
  }

  .aiBadge {
    margin-top: 17px;

    font-size: 9px;
  }

  .aiArea h3 {
    margin-top: 12px;

    font-size: 17px;
  }

  .aiArea > p {
    margin-top: 8px;

    font-size: 10px;

    line-height: 1.55;
  }

  .aiSignals {
    margin-top: 16px;
  }

  .aiSignals span {
    padding: 6px 9px;

    font-size: 7.5px;
  }

  /* -------------------------------------------------------
     CONNECTORS
     Place them exactly between cards and AI.
     ------------------------------------------------------- */

  .connector {
    z-index: 5;

    top: 50%;

    width: 70px;
    height: 60px;

    transform: translateY(-50%);
  }

  .connectorLeft {
    left: calc(50% - 305px);
  }

  .connectorRight {
    right: calc(50% - 305px);
  }

  .connectorLine {
    top: 50%;

    width: 100%;

    opacity: .85;
  }

  /* -------------------------------------------------------
     PROFILE CARD
     ------------------------------------------------------- */

  .profilePanel .panelTop h3,
  .matchesPanel .panelTop h3 {
    font-size: 19px;
  }

  .profileList {
    gap: 9px;

    margin-top: 21px;
  }

  .profileItem {
    min-height: 57px;

    padding: 10px 11px;
  }

  .profileIcon {
    width: 31px;
    height: 31px;

    flex-basis: 31px;
  }

  .profileCopy {
    margin-left: 11px;
  }

  .profileCopy strong {
    font-size: 10px;
  }

  .profileCopy small {
    margin-top: 4px;

    font-size: 8.5px;
  }

  .profileFooter {
    margin-top: 21px;

    font-size: 9px;
  }

  .profileFooter strong {
    font-size: 11px;
  }

  /* -------------------------------------------------------
     MATCH CARDS
     ------------------------------------------------------- */

  .matchList {
    gap: 9px;

    margin-top: 22px;
  }

  .matchCard {
    min-height: 84px;

    padding:
      13px
      13px
      12px
      16px;
  }

  .matchScore strong {
    font-size: 17px;
  }

  .matchScore span {
    font-size: 7.5px;
  }

  .matchInfo {
    margin-top: 6px;
  }

  .matchInfo strong {
    font-size: 10px;
  }

  .matchInfo span {
    margin-top: 4px;

    font-size: 7.5px;
  }

  .moreMatches {
    margin-top: 11px;

    padding: 11px 12px;

    font-size: 8.5px;
  }

  /* -------------------------------------------------------
     WHY IT WORKS
     Put it beneath the three-column system instead of
     overlapping the cards.
     ------------------------------------------------------- */

  .whyCard {
    left: 50%;

    bottom: -76px;

    width: 680px;

    padding: 19px 22px;

    transform: translateX(-50%);
  }

  .whyHeader h3 {
    font-size: 13px;
  }

  .reason {
    min-height: 39px;

    padding: 9px 9px;
  }

  .reason strong {
    font-size: 7.5px;
  }

  .whyFooter {
    font-size: 8.5px;
  }


}


/* =========================================================
   EXTRA LARGE DESKTOP
   ========================================================= */

@media (min-width: 1450px) {

  .stage {
    width: 1120px;

    grid-template-columns:
      330px
      320px
      330px;

    column-gap: 70px;
  }

  .profilePanel,
  .matchesPanel {
    width: 330px;
  }

  .aiArea {
    width: 320px;
  }

  .connectorLeft {
    left: calc(50% - 320px);
  }

  .connectorRight {
    right: calc(50% - 320px);
  }
}


/* =========================================================
   TABLET — KEEP THE COMPOSITION CONTROLLED
   ========================================================= */

@media (min-width: 801px) and (max-width: 1180px) {

  .stage {
    width: 920px;
    max-width: 100%;

    grid-template-columns:
      minmax(230px, 275px)
      minmax(220px, 260px)
      minmax(230px, 275px);

    column-gap: 28px;
  }

  .profilePanel,
  .matchesPanel {
    width: 100%;
  }

  .aiArea {
    width: 100%;
  }

  .connector {
    display: none;
  }

  .whyCard {
    width: min(650px, calc(100% - 30px));
  }
}


/* =========================================================
   MOBILE — DO NOT LET DESKTOP FIXES LEAK
   ========================================================= */

@media (max-width: 800px) {

  .stage {
    width: 100%;
    max-width: none;

    display: flex;

    flex-direction: column;
  }

  .profilePanel,
  .matchesPanel,
  .aiArea {
    width: 100%;
  }

  .whyCard {
    width: 100%;

    position: relative;

    left: auto;
    bottom: auto;

    transform: none;
  }
}


/* ============================================================
   SECTION 3 — FINAL COMPOSITION V2
   ONE PROFILE → AI MATCHING → RELEVANT OPPORTUNITIES

   Desktop visual hierarchy:
   ┌─────────────┐       ✦       ┌─────────────┐
   │ YOUR PROFILE│ ──── AI ────> │ BEST MATCHES│
   └─────────────┘               └─────────────┘
                       ↓
                 WHY IT WORKS

   This override is isolated to Section 3.
   ============================================================ */


@media (min-width: 1181px) {

  /* ------------------------------------------------------------
     SECTION
     ------------------------------------------------------------ */

  .section {
    position: relative;

    padding-top: 96px !important;
    padding-bottom: 128px !important;

    overflow: hidden;
  }


  /* ------------------------------------------------------------
     HEADER
     ------------------------------------------------------------ */

  .header {
    position: relative;
    z-index: 20;

    width: min(900px, calc(100% - 60px));

    margin: 0 auto 54px !important;

    text-align: center;
  }

  .header h2 {
    max-width: 760px;

    margin: 0 auto;

    font-size: clamp(48px, 4vw, 64px) !important;

    line-height: .98 !important;

    letter-spacing: -0.055em;
  }

  .header p {
    max-width: 610px;

    margin: 22px auto 0 !important;

    font-size: 14px !important;

    line-height: 1.65 !important;

    opacity: .78;
  }


  /* ------------------------------------------------------------
     MAIN STAGE

     IMPORTANT:
     Everything is positioned relative to this SAME canvas.
     That guarantees the visual remains centered.
     ------------------------------------------------------------ */

  .stage {
    position: relative !important;

    width: min(1180px, calc(100% - 80px)) !important;

    height: 610px !important;

    margin: 0 auto !important;

    display: block !important;
  }


  /* ------------------------------------------------------------
     LEFT PROFILE PANEL
     ------------------------------------------------------------ */

  .profilePanel {
    position: absolute !important;

    left: 0 !important;
    top: 84px !important;

    width: 330px !important;

    height: 408px !important;

    margin: 0 !important;

    padding: 27px !important;

    z-index: 10;

    border-radius: 24px !important;

    transform: translateZ(0);

    transition:
      transform .6s cubic-bezier(.22,1,.36,1),
      box-shadow .6s ease,
      border-color .5s ease;
  }


  /* ------------------------------------------------------------
     RIGHT MATCHES PANEL
     ------------------------------------------------------------ */

  .matchesPanel {
    position: absolute !important;

    right: 0 !important;
    top: 84px !important;

    width: 330px !important;

    height: 408px !important;

    margin: 0 !important;

    padding: 27px !important;

    z-index: 10;

    border-radius: 24px !important;

    transform: translateZ(0);

    transition:
      transform .6s cubic-bezier(.22,1,.36,1),
      box-shadow .6s ease,
      border-color .5s ease;
  }


  /* ------------------------------------------------------------
     PREMIUM CARD HOVER
     ------------------------------------------------------------ */

  .profilePanel:hover {
    transform: translateY(-5px) !important;

    box-shadow:
      0 30px 70px rgba(71, 51, 150, .13);
  }

  .matchesPanel:hover {
    transform: translateY(-5px) !important;

    box-shadow:
      0 30px 70px rgba(71, 51, 150, .13);
  }


  /* ------------------------------------------------------------
     CENTER AI AREA

     EXACT CENTER OF THE SECTION.
     ------------------------------------------------------------ */

  .aiArea {
    position: absolute !important;

    left: 50% !important;
    top: 54px !important;

    width: 330px !important;
    height: 440px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    display: flex !important;

    flex-direction: column !important;

    align-items: center !important;

    z-index: 12;
  }


  /* ------------------------------------------------------------
     AI UNDERSTANDS

     It must sit directly above the AI core.
     ------------------------------------------------------------ */

  .aiUnderstands,
  .ai-understands {
    position: absolute !important;

    left: 50% !important;
    top: 0 !important;

    width: 190px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    text-align: left !important;

    z-index: 15;
  }


  .aiUnderstands h3,
  .ai-understands h3 {
    margin: 0 0 14px !important;

    font-size: 18px !important;

    line-height: 1.1 !important;

    letter-spacing: -0.025em;
  }


  .checks {
    display: flex;

    flex-direction: column;

    gap: 7px;
  }


  .check {
    display: flex;

    align-items: center;

    gap: 9px;

    min-height: 25px;

    font-size: 10px;

    line-height: 1.2;
  }


  .check i {
    width: 21px;
    height: 21px;

    flex: 0 0 21px;

    display: grid;

    place-items: center;

    border-radius: 50%;

    border: 2px solid rgba(126, 91, 255, .62);

    font-size: 10px;

    font-style: normal;
  }


  /* ------------------------------------------------------------
     AI HALO / CORE

     Strong central visual anchor.
     ------------------------------------------------------------ */

  .aiHalo {
    position: absolute !important;

    left: 50% !important;
    top: 194px !important;

    width: 230px !important;
    height: 230px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;
  }


  .aiCore {
    width: 126px !important;
    height: 126px !important;

    left: 50% !important;
    top: 52px !important;

    transform: translateX(-50%) !important;

    border-radius: 50%;

    animation:
      section3CoreBreath 3.6s ease-in-out infinite;
  }


  @keyframes section3CoreBreath {

    0%,
    100% {
      transform: translateX(-50%) scale(1);
      filter: brightness(1);
    }

    50% {
      transform: translateX(-50%) scale(1.045);
      filter: brightness(1.06);
    }
  }


  /* ------------------------------------------------------------
     AI LABEL
     ------------------------------------------------------------ */

  .aiLabel {
    position: absolute !important;

    left: 50% !important;

    top: 342px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    text-align: center;

    white-space: nowrap;

    z-index: 15;
  }


  .aiLabel h3,
  .ai-label h3 {
    margin: 0 !important;

    font-size: 19px !important;

    line-height: 1.15 !important;

    letter-spacing: -0.025em;
  }


  .aiLabel p,
  .ai-label p {
    max-width: 190px;

    margin: 9px auto 0 !important;

    font-size: 9px !important;

    line-height: 1.55 !important;
  }


  /* ------------------------------------------------------------
     AI SIGNAL CHIPS
     ------------------------------------------------------------ */

  .aiSignals {
    position: absolute !important;

    left: 50% !important;
    top: 403px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    display: flex;

    justify-content: center;

    gap: 6px;

    width: 260px;
  }

  .aiSignals span {
    padding: 6px 9px !important;

    font-size: 7px !important;

    border-radius: 999px;
  }


  /* ------------------------------------------------------------
     CONNECTOR SYSTEM

     Put the visual connection exactly between the cards
     and the central AI.
     ------------------------------------------------------------ */

  .connectors {
    position: absolute !important;

    inset: 0 !important;

    width: 100% !important;
    height: 100% !important;

    z-index: 5;

    pointer-events: none;
  }

  .connectors svg {
    position: absolute;

    inset: 0;

    width: 100% !important;
    height: 100% !important;

    overflow: visible;
  }


  /* ------------------------------------------------------------
     WHY IT WORKS

     NO OVERLAP WITH THE CARDS.
     ------------------------------------------------------------ */

  .whyCard {
    position: absolute !important;

    left: 50% !important;

    top: 520px !important;
    bottom: auto !important;

    width: 680px !important;

    min-height: 105px !important;

    margin: 0 !important;

    padding: 18px 22px !important;

    transform: translateX(-50%) !important;

    z-index: 20;

    border-radius: 19px !important;

    box-shadow:
      0 18px 50px rgba(68, 49, 145, .08);
  }


  .whyHeader {
    margin-bottom: 13px;
  }


  .whyHeader h3 {
    font-size: 13px !important;

    line-height: 1.2;
  }


  .reasons {
    display: grid !important;

    grid-template-columns:
      repeat(5, minmax(0, 1fr));

    gap: 7px !important;
  }


  .reason {
    min-width: 0;

    min-height: 38px !important;

    padding: 8px !important;

    border-radius: 10px !important;
  }


  .reason strong {
    font-size: 7px !important;

    line-height: 1.25;
  }


  .whyFooter {
    margin-top: 10px;

    font-size: 8px !important;

    text-align: center;
  }


  /* ------------------------------------------------------------
     MICRO MOTION

     Very slow. No gimmicky movement.
     ------------------------------------------------------------ */

  .profilePanel,
  .matchesPanel {
    animation:
      section3CardFloat 6s ease-in-out infinite;
  }

  .matchesPanel {
    animation-delay: -2.8s;
  }


  @keyframes section3CardFloat {

    0%,
    100% {
      margin-top: 0;
    }

    50% {
      margin-top: -4px;
    }
  }


  /* AI rings breathe independently. */

  .ringOne {
    animation:
      section3RingOne 5s ease-in-out infinite;
  }

  .ringTwo {
    animation:
      section3RingTwo 6s ease-in-out infinite;
  }

  .ringThree {
    animation:
      section3RingThree 7s ease-in-out infinite;
  }


  @keyframes section3RingOne {

    0%,
    100% {
      opacity: .72;

      transform: scale(1);
    }

    50% {
      opacity: 1;

      transform: scale(1.035);
    }
  }


  @keyframes section3RingTwo {

    0%,
    100% {
      opacity: .45;

      transform: scale(1);
    }

    50% {
      opacity: .72;

      transform: scale(1.055);
    }
  }


  @keyframes section3RingThree {

    0%,
    100% {
      opacity: .28;

      transform: scale(1);
    }

    50% {
      opacity: .52;

      transform: scale(1.075);
    }
  }
}


/* ============================================================
   LAPTOP
   ============================================================ */

@media (min-width: 901px) and (max-width: 1180px) {

  .section {
    padding-left: 25px !important;
    padding-right: 25px !important;
  }

  .stage {
    width: min(920px, 100%) !important;

    height: 560px !important;
  }

  .profilePanel,
  .matchesPanel {
    width: 270px !important;

    height: 370px !important;

    padding: 21px !important;
  }

  .aiArea {
    width: 280px !important;
  }

  .aiHalo {
    width: 190px !important;
    height: 190px !important;
  }

  .whyCard {
    width: 610px !important;

    top: 480px !important;
  }
}


/* ============================================================
   MOBILE
   Desktop positioning MUST NOT LEAK.
   ============================================================ */

@media (max-width: 900px) {

  .section {
    overflow: hidden;
  }

  .header {
    width: calc(100% - 32px);

    margin-bottom: 38px !important;
  }

  .header h2 {
    font-size: clamp(36px, 10vw, 48px) !important;

    line-height: 1 !important;
  }

  .header p {
    font-size: 13px !important;

    line-height: 1.55 !important;
  }

  .stage {
    width: calc(100% - 28px) !important;

    height: auto !important;

    min-height: 0 !important;

    display: flex !important;

    flex-direction: column !important;

    align-items: center !important;

    gap: 24px !important;
  }

  .profilePanel,
  .matchesPanel,
  .aiArea,
  .whyCard {
    position: relative !important;

    left: auto !important;
    right: auto !important;
    top: auto !important;
    bottom: auto !important;

    width: 100% !important;

    height: auto !important;

    min-height: 0 !important;

    transform: none !important;

    margin: 0 !important;
  }

  .aiArea {
    order: 2;

    min-height: 410px !important;
  }

  .profilePanel {
    order: 1;
  }

  .matchesPanel {
    order: 3;
  }

  .whyCard {
    order: 4;

    margin-top: 5px !important;
  }

  .connectors {
    display: none !important;
  }

  .aiUnderstands,
  .ai-understands {
    position: relative !important;

    left: auto !important;
    top: auto !important;

    width: 190px !important;

    transform: none !important;

    margin: 0 auto !important;
  }

  .aiHalo {
    position: relative !important;

    left: auto !important;
    top: auto !important;

    width: 210px !important;
    height: 210px !important;

    transform: none !important;

    margin: 25px auto 0 !important;
  }

  .aiCore {
    left: 50% !important;
  }

  .aiLabel {
    position: relative !important;

    left: auto !important;
    top: auto !important;

    transform: none !important;

    margin: 20px auto 0 !important;
  }

  .aiSignals {
    position: relative !important;

    left: auto !important;
    top: auto !important;

    width: 100% !important;

    transform: none !important;

    margin: 14px auto 0 !important;
  }

  .reasons {
    grid-template-columns: 1fr 1fr !important;
  }
}


/* ============================================================
   ACCESSIBILITY
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

  .profilePanel,
  .matchesPanel,
  .aiCore,
  .ringOne,
  .ringTwo,
  .ringThree {
    animation: none !important;
  }
}


/* ============================================================
   SECTION 3 — FINAL PREMIUM ONE-SCREEN COMPOSITION
   ------------------------------------------------------------
   Concept:

          ONE PROFILE. EVERY RELEVANT OPPORTUNITY.

       PROFILE          AI MATCHING          MATCHES
          \                 ✦                 /
           \                │                /
            ───────── UNDERSTANDS ──────────

                    WHY IT WORKS

   Section 3 is intentionally treated as ONE visual system.
   ============================================================ */


@media (min-width: 1181px) {

  /* ------------------------------------------------------------
     1. SECTION BOUNDARY
     ------------------------------------------------------------ */

  .section {
    position: relative !important;

    min-height: 100vh !important;

    box-sizing: border-box !important;

    padding:
      86px
      0
      74px !important;

    overflow: hidden !important;

    background:
      radial-gradient(
        circle at 50% 48%,
        rgba(126, 91, 255, .105) 0%,
        rgba(126, 91, 255, .045) 23%,
        rgba(126, 91, 255, 0) 55%
      ),
      linear-gradient(
        180deg,
        #ffffff 0%,
        #fbfaff 46%,
        #f7f4ff 100%
      ) !important;
  }


  /* top section separation */

  .section::before {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    top: 0;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(117, 84, 245, .18),
        transparent
      );

    pointer-events: none;
  }


  /* bottom section separation */

  .section::after {
    content: "";

    position: absolute;

    left: 7%;
    right: 7%;
    bottom: 0;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(117, 84, 245, .20),
        transparent
      );

    pointer-events: none;
  }


  /* ------------------------------------------------------------
     2. HEADER
     ------------------------------------------------------------ */

  .header {
    position: relative !important;

    z-index: 30 !important;

    width: min(850px, calc(100% - 60px)) !important;

    margin:
      0
      auto
      42px !important;

    text-align: center !important;
  }


  .header h2 {
    max-width: 820px !important;

    margin: 0 auto !important;

    font-size:
      clamp(48px, 4.1vw, 64px) !important;

    line-height: .98 !important;

    letter-spacing: -.055em !important;
  }


  .header p {
    max-width: 610px !important;

    margin:
      18px
      auto
      0 !important;

    font-size: 13px !important;

    line-height: 1.55 !important;

    opacity: .72 !important;
  }


  /* ------------------------------------------------------------
     3. SINGLE CONTROLLED CANVAS
     ------------------------------------------------------------ */

  .stage {
    position: relative !important;

    width: min(1160px, calc(100% - 80px)) !important;

    height: 610px !important;

    margin: 0 auto !important;

    display: block !important;
  }


  /* ------------------------------------------------------------
     4. LEFT PROFILE
     ------------------------------------------------------------ */

  .profilePanel {
    position: absolute !important;

    left: 0 !important;

    top: 92px !important;

    width: 320px !important;

    height: 392px !important;

    box-sizing: border-box !important;

    margin: 0 !important;

    padding: 26px !important;

    z-index: 12 !important;

    border-radius: 22px !important;

    transform: translateY(0) !important;

    animation:
      section3LeftFloat
      6.5s
      ease-in-out
      infinite !important;

    transition:
      box-shadow .45s ease,
      border-color .45s ease !important;
  }


  @keyframes section3LeftFloat {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-4px);
    }
  }


  /* ------------------------------------------------------------
     5. RIGHT MATCHES
     ------------------------------------------------------------ */

  .matchesPanel {
    position: absolute !important;

    right: 0 !important;

    top: 92px !important;

    width: 320px !important;

    height: 392px !important;

    box-sizing: border-box !important;

    margin: 0 !important;

    padding: 26px !important;

    z-index: 12 !important;

    border-radius: 22px !important;

    transform: translateY(0) !important;

    animation:
      section3RightFloat
      6.5s
      ease-in-out
      -2.7s
      infinite !important;

    transition:
      box-shadow .45s ease,
      border-color .45s ease !important;
  }


  @keyframes section3RightFloat {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-4px);
    }
  }


  /* ------------------------------------------------------------
     6. CARD HOVER
     ------------------------------------------------------------ */

  .profilePanel:hover,
  .matchesPanel:hover {
    animation-play-state: paused !important;

    box-shadow:
      0 24px 70px rgba(78, 52, 170, .14) !important;
  }


  /* ------------------------------------------------------------
     7. CENTER AI SYSTEM
     ------------------------------------------------------------ */

  .aiArea {
    position: absolute !important;

    left: 50% !important;

    top: 0 !important;

    width: 330px !important;

    height: 500px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    display: block !important;

    z-index: 20 !important;
  }


  /* ------------------------------------------------------------
     8. AI UNDERSTANDS

     This is deliberately separated from the core.
     ------------------------------------------------------------ */

  .aiUnderstands,
  .ai-understands {
    position: absolute !important;

    left: 50% !important;

    top: 8px !important;

    width: 205px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    text-align: left !important;

    z-index: 25 !important;
  }


  .aiUnderstands h3,
  .ai-understands h3 {
    margin:
      0
      0
      12px !important;

    font-size: 17px !important;

    line-height: 1.1 !important;

    letter-spacing: -.025em !important;
  }


  .aiUnderstands .check,
  .ai-understands .check {
    display: flex !important;

    align-items: center !important;

    gap: 9px !important;

    min-height: 25px !important;

    font-size: 10px !important;
  }


  /* ------------------------------------------------------------
     9. AI CORE

     Exact center axis.
     ------------------------------------------------------------ */

  .aiHalo {
    position: absolute !important;

    left: 50% !important;

    top: 186px !important;

    width: 220px !important;

    height: 220px !important;

    margin: 0 !important;

    transform:
      translateX(-50%)
      translateY(0) !important;

    z-index: 21 !important;

    animation:
      section3HaloFloat
      5.5s
      ease-in-out
      infinite !important;
  }


  @keyframes section3HaloFloat {

    0%,
    100% {
      transform:
        translateX(-50%)
        translateY(0);
    }

    50% {
      transform:
        translateX(-50%)
        translateY(-5px);
    }
  }


  .aiCore {
    width: 124px !important;

    height: 124px !important;

    left: 50% !important;

    top: 48px !important;

    transform: translateX(-50%) !important;

    animation:
      section3CorePulse
      3.8s
      ease-in-out
      infinite !important;
  }


  @keyframes section3CorePulse {

    0%,
    100% {
      filter: brightness(1);

      transform:
        translateX(-50%)
        scale(1);
    }

    50% {
      filter: brightness(1.08);

      transform:
        translateX(-50%)
        scale(1.045);
    }
  }


  /* ------------------------------------------------------------
     10. AI RINGS
     ------------------------------------------------------------ */

  .ringOne {
    animation:
      section3RingA
      5s
      ease-in-out
      infinite !important;
  }

  .ringTwo {
    animation:
      section3RingB
      6.5s
      ease-in-out
      infinite !important;
  }

  .ringThree {
    animation:
      section3RingC
      8s
      ease-in-out
      infinite !important;
  }


  @keyframes section3RingA {

    0%,
    100% {
      opacity: .62;

      transform: scale(1);
    }

    50% {
      opacity: .95;

      transform: scale(1.035);
    }
  }


  @keyframes section3RingB {

    0%,
    100% {
      opacity: .38;

      transform: scale(1);
    }

    50% {
      opacity: .65;

      transform: scale(1.06);
    }
  }


  @keyframes section3RingC {

    0%,
    100% {
      opacity: .20;

      transform: scale(1);
    }

    50% {
      opacity: .40;

      transform: scale(1.08);
    }
  }


  /* ------------------------------------------------------------
     11. AI LABEL

     Sits below core with proper breathing room.
     ------------------------------------------------------------ */

  .aiLabel {
    position: absolute !important;

    left: 50% !important;

    top: 414px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    text-align: center !important;

    white-space: nowrap !important;

    z-index: 25 !important;
  }


  .aiLabel h3,
  .ai-label h3 {
    margin: 0 !important;

    font-size: 18px !important;

    line-height: 1.15 !important;

    letter-spacing: -.025em !important;
  }


  .aiLabel p,
  .ai-label p {
    max-width: 210px !important;

    margin:
      8px
      auto
      0 !important;

    font-size: 9px !important;

    line-height: 1.55 !important;
  }


  /* ------------------------------------------------------------
     12. SIGNAL CHIPS
     ------------------------------------------------------------ */

  .aiSignals {
    position: absolute !important;

    left: 50% !important;

    top: 470px !important;

    width: 270px !important;

    margin: 0 !important;

    transform: translateX(-50%) !important;

    display: flex !important;

    justify-content: center !important;

    gap: 6px !important;

    z-index: 25 !important;
  }


  .aiSignals span {
    padding:
      6px
      10px !important;

    font-size: 7px !important;

    border-radius: 999px !important;
  }


  /* ------------------------------------------------------------
     13. CONNECTOR LAYER

     No giant decorative curves.
     They should communicate actual flow.
     ------------------------------------------------------------ */

  .connectors {
    position: absolute !important;

    inset: 0 !important;

    width: 100% !important;

    height: 100% !important;

    z-index: 6 !important;

    pointer-events: none !important;
  }


  .connectors svg {
    position: absolute !important;

    inset: 0 !important;

    width: 100% !important;

    height: 100% !important;

    overflow: visible !important;
  }


  /* ------------------------------------------------------------
     14. WHY IT WORKS

     Separate layer underneath the system.
     ------------------------------------------------------------ */

  .whyCard {
    position: absolute !important;

    left: 50% !important;

    top: 518px !important;

    bottom: auto !important;

    width: 680px !important;

    min-height: 96px !important;

    margin: 0 !important;

    padding:
      17px
      22px !important;

    box-sizing: border-box !important;

    transform: translateX(-50%) !important;

    z-index: 30 !important;

    border-radius: 18px !important;

    box-shadow:
      0 18px 55px rgba(77, 55, 160, .09) !important;
  }


  .whyHeader {
    margin-bottom: 10px !important;
  }


  .whyHeader h3 {
    font-size: 13px !important;

    line-height: 1.2 !important;
  }


  .reasons {
    display: grid !important;

    grid-template-columns:
      repeat(5, minmax(0, 1fr)) !important;

    gap: 7px !important;
  }


  .reason {
    min-width: 0 !important;

    min-height: 36px !important;

    padding:
      7px
      8px !important;

    border-radius: 9px !important;
  }


  .reason strong {
    font-size: 7px !important;

    line-height: 1.2 !important;
  }


  .whyFooter {
    margin-top: 8px !important;

    font-size: 8px !important;

    text-align: center !important;
  }


}


/* ============================================================
   LAPTOP
   ============================================================ */

@media (min-width: 901px) and (max-width: 1180px) {

  .section {
    min-height: 100vh !important;

    padding:
      70px
      20px
      60px !important;
  }

  .stage {
    width: min(920px, 100%) !important;

    height: 560px !important;
  }

  .profilePanel,
  .matchesPanel {
    width: 265px !important;

    height: 360px !important;

    padding: 20px !important;
  }

  .profilePanel {
    left: 0 !important;

    top: 105px !important;
  }

  .matchesPanel {
    right: 0 !important;

    top: 105px !important;
  }

  .aiArea {
    width: 280px !important;
  }

  .aiHalo {
    width: 190px !important;

    height: 190px !important;

    top: 195px !important;
  }

  .whyCard {
    width: 600px !important;

    top: 485px !important;
  }
}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 900px) {

  .section {
    min-height: auto !important;

    padding:
      70px
      0
      80px !important;

    background:
      linear-gradient(
        180deg,
        #ffffff 0%,
        #faf8ff 100%
      ) !important;
  }


  .header {
    width: calc(100% - 32px) !important;

    margin:
      0
      auto
      40px !important;
  }


  .header h2 {
    font-size:
      clamp(36px, 10vw, 48px) !important;

    line-height: 1 !important;
  }


  .header p {
    font-size: 13px !important;

    line-height: 1.55 !important;
  }


  .stage {
    width: calc(100% - 28px) !important;

    height: auto !important;

    min-height: 0 !important;

    display: flex !important;

    flex-direction: column !important;

    align-items: center !important;

    gap: 24px !important;
  }


  .profilePanel,
  .matchesPanel,
  .aiArea,
  .whyCard {
    position: relative !important;

    left: auto !important;

    right: auto !important;

    top: auto !important;

    bottom: auto !important;

    width: 100% !important;

    height: auto !important;

    min-height: 0 !important;

    margin: 0 !important;

    transform: none !important;
  }


  .profilePanel,
  .matchesPanel {
    animation: none !important;
  }


  .profilePanel {
    order: 1 !important;
  }


  .aiArea {
    order: 2 !important;

    height: 430px !important;

    min-height: 430px !important;
  }


  .matchesPanel {
    order: 3 !important;
  }


  .whyCard {
    order: 4 !important;
  }


  .connectors {
    display: none !important;
  }


  .aiUnderstands,
  .ai-understands {
    position: relative !important;

    left: auto !important;

    top: auto !important;

    width: 205px !important;

    transform: none !important;

    margin:
      0
      auto !important;
  }


  .aiHalo {
    position: relative !important;

    left: auto !important;

    top: auto !important;

    width: 205px !important;

    height: 205px !important;

    margin:
      25px
      auto
      0 !important;

    transform: none !important;
  }


  .aiCore {
    left: 50% !important;
  }


  .aiLabel {
    position: relative !important;

    left: auto !important;

    top: auto !important;

    transform: none !important;

    margin:
      20px
      auto
      0 !important;
  }


  .aiSignals {
    position: relative !important;

    left: auto !important;

    top: auto !important;

    width: 100% !important;

    transform: none !important;

    margin:
      14px
      auto
      0 !important;
  }


  .reasons {
    grid-template-columns:
      1fr 1fr !important;
  }
}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

  .profilePanel,
  .matchesPanel,
  .aiHalo,
  .aiCore,
  .ringOne,
  .ringTwo,
  .ringThree {
    animation: none !important;
  }
}


/* ============================================================
   SECTION 3 — VISUAL IDENTITY / SECTION BREAK
   ------------------------------------------------------------
   Section 3 intentionally moves from white into a soft
   lavender environment so it reads as a NEW section.

   Purple remains the brand accent, but the background,
   atmosphere and spacing are different from Section 1.
   ============================================================ */


.section {
  position: relative;

  isolation: isolate;

  background:
    radial-gradient(
      700px 500px at 50% 42%,
      rgba(122, 82, 255, 0.12),
      rgba(122, 82, 255, 0.035) 48%,
      transparent 75%
    ),
    linear-gradient(
      180deg,
      #f8f6ff 0%,
      #f5f1ff 48%,
      #f8f6ff 100%
    ) !important;

  overflow: hidden;
}


/* ------------------------------------------------------------
   SOFT TOP TRANSITION
   Makes the section feel like it has entered a new
   visual chapter rather than continuing Section 1.
   ------------------------------------------------------------ */

.section::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  height: 150px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,0.96),
      rgba(248,246,255,0)
    );

  pointer-events: none;

  z-index: -1;
}


/* ------------------------------------------------------------
   SOFT BOTTOM TRANSITION
   ------------------------------------------------------------ */

.section::after {
  content: "";

  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  height: 140px;

  background:
    linear-gradient(
      180deg,
      transparent,
      rgba(255,255,255,.58)
    );

  pointer-events: none;

  z-index: -1;
}


/* ============================================================
   LARGE AMBIENT LIGHT
   ============================================================ */

.section {
  --section-purple: #7650f5;
  --section-purple-soft: rgba(118,80,245,.14);
}


.section .backgroundGlow {
  position: absolute;

  width: 760px;
  height: 760px;

  left: 50%;
  top: 45%;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(122,82,255,.13) 0%,
      rgba(122,82,255,.055) 32%,
      rgba(122,82,255,.018) 55%,
      transparent 72%
    );

  filter: blur(8px);

  pointer-events: none;

  z-index: -2;
}


/* ============================================================
   SUBTLE GRID
   ------------------------------------------------------------
   Different from Section 1's visual language.
   ============================================================ */

.section .grid,
.section .gridGlow {
  opacity: .42;

  background-image:
    linear-gradient(
      rgba(107,82,190,.055) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(107,82,190,.055) 1px,
      transparent 1px
    );

  background-size:
    64px 64px;

  mask-image:
    radial-gradient(
      ellipse at center,
      black 0%,
      rgba(0,0,0,.7) 42%,
      transparent 78%
    );

  pointer-events: none;
}


/* ============================================================
   DECORATIVE DOT FIELD
   ============================================================ */

.section .ambientDots {
  position: absolute;

  width: 460px;
  height: 320px;

  left: 50%;
  top: 43%;

  transform: translate(-50%, -50%);

  background-image:
    radial-gradient(
      rgba(116,82,245,.22) 1.2px,
      transparent 1.2px
    );

  background-size: 24px 24px;

  opacity: .22;

  mask-image:
    radial-gradient(
      ellipse,
      black 0%,
      transparent 72%
    );

  pointer-events: none;

  z-index: -1;
}


/* ============================================================
   HEADER — STRONGER CONTRAST AGAINST LAVENDER
   ============================================================ */

.header {
  position: relative;

  z-index: 10;
}


.header h2 {
  color: #15162d !important;
}


.header h2 span {
  color: #7046ed !important;
}


.header p {
  color: #777591 !important;
}


/* ============================================================
   MAIN VISUAL — FLOAT ABOVE BACKGROUND
   ============================================================ */

.stage {
  position: relative;

  z-index: 5;
}


/* ============================================================
   CARDS
   ------------------------------------------------------------
   White cards now deliberately contrast against lavender.
   ============================================================ */

.profilePanel,
.matchesPanel {
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.98),
      rgba(255,255,255,.91)
    ) !important;

  border:
    1px solid rgba(112,78,224,.13) !important;

  box-shadow:
    0 24px 70px rgba(84,59,165,.10),
    0 3px 14px rgba(84,59,165,.05) !important;

  backdrop-filter: blur(12px);

  -webkit-backdrop-filter: blur(12px);
}


/* Slight purple interaction */

.profilePanel:hover,
.matchesPanel:hover {
  border-color:
    rgba(112,78,224,.25) !important;

  box-shadow:
    0 30px 80px rgba(84,59,165,.15),
    0 4px 18px rgba(84,59,165,.06) !important;
}


/* ============================================================
   CENTER AI — MORE IMPORTANT IN THIS SECTION
   ============================================================ */

.aiArea {
  position: relative;

  z-index: 12;
}


/* soft AI environment */

.aiArea::before {
  content: "";

  position: absolute;

  width: 360px;
  height: 360px;

  left: 50%;
  top: 46%;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(116,78,245,.16),
      rgba(116,78,245,.055) 42%,
      transparent 72%
    );

  filter: blur(12px);

  pointer-events: none;

  z-index: -1;
}


/* ============================================================
   AI CORE
   ============================================================ */

.aiCore {
  box-shadow:
    0 0 0 10px rgba(116,79,245,.07),
    0 0 0 22px rgba(116,79,245,.045),
    0 18px 50px rgba(96,62,225,.24) !important;
}


/* ============================================================
   WHY IT WORKS — DISTINCT WHITE FLOATING PANEL
   ============================================================ */

.whyCard {
  background:
    rgba(255,255,255,.92) !important;

  border:
    1px solid rgba(111,78,225,.13) !important;

  box-shadow:
    0 22px 65px rgba(82,57,161,.10) !important;

  backdrop-filter: blur(14px);

  -webkit-backdrop-filter: blur(14px);
}


/* ============================================================
   SECTION 3 → CTA TRANSITION
   A little extra breathing room at the bottom.
   ============================================================ */

@media (min-width: 901px) {

  .section {
    padding-bottom: 105px !important;
  }

}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 900px) {

  .section {
    background:
      radial-gradient(
        420px 350px at 50% 35%,
        rgba(122,82,255,.10),
        transparent 70%
      ),
      linear-gradient(
        180deg,
        #faf9ff 0%,
        #f5f1ff 52%,
        #faf9ff 100%
      ) !important;
  }

  .section .backgroundGlow {
    width: 420px;
    height: 420px;
  }

  .section .ambientDots {
    width: 300px;
    height: 250px;

    opacity: .15;
  }

  .profilePanel,
  .matchesPanel,
  .whyCard {
    box-shadow:
      0 16px 45px rgba(84,59,165,.09) !important;
  }

}


/* ============================================================
   ACCESSIBILITY
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

  .aiCore,
  .aiHalo,
  .profilePanel,
  .matchesPanel {
    animation: none !important;
  }

}


/* ============================================================
   SECTION 3 — CARD + CENTER ALIGNMENT FINAL
   Only Section 3.
   ============================================================ */

@media (min-width: 1181px) {

  /* ------------------------------------------------------------
     MOVE BOTH SIDE CARDS UP
     ------------------------------------------------------------ */

  .profilePanel {
    top: 58px !important;
  }

  .matchesPanel {
    top: 58px !important;
  }


  /* ------------------------------------------------------------
     CENTER AI AREA
     ------------------------------------------------------------ */

  .aiArea {
    top: 0 !important;

    left: 50% !important;

    transform: translateX(-50%) !important;

    display: block !important;
  }


  /* ------------------------------------------------------------
     AI MATCHING — CIRCULAR START POINT

     Creates a clean circular visual anchor in the middle.
     ------------------------------------------------------------ */

  .aiArea::after {
    content: "";

    position: absolute;

    left: 50%;

    top: 177px;

    width: 246px;

    height: 246px;

    transform: translateX(-50%);

    border-radius: 50%;

    border:
      1px solid rgba(118, 80, 245, .16);

    background:
      radial-gradient(
        circle,
        rgba(118, 80, 245, .08) 0%,
        rgba(118, 80, 245, .035) 38%,
        rgba(118, 80, 245, 0) 70%
      );

    box-shadow:
      0 0 0 18px rgba(118, 80, 245, .025),
      0 0 0 38px rgba(118, 80, 245, .018);

    pointer-events: none;

    z-index: 0;

    animation:
      section3StartCircle
      5s
      ease-in-out
      infinite;
  }


  @keyframes section3StartCircle {

    0%,
    100% {
      opacity: .72;

      transform:
        translateX(-50%)
        scale(1);
    }

    50% {
      opacity: 1;

      transform:
        translateX(-50%)
        scale(1.035);
    }
  }


  /* ------------------------------------------------------------
     KEEP ALL CENTER CONTENT ABOVE CIRCLE
     ------------------------------------------------------------ */

  .aiUnderstands,
  .ai-understands,
  .aiHalo,
  .aiLabel,
  .ai-label,
  .aiSignals {
    z-index: 10 !important;
  }


  /* ------------------------------------------------------------
     AI HALO — CENTER IT INSIDE THE CIRCLE
     ------------------------------------------------------------ */

  .aiHalo {
    top: 190px !important;

    left: 50% !important;

    width: 220px !important;

    height: 220px !important;

    transform:
      translateX(-50%) !important;
  }


  /* ------------------------------------------------------------
     AI CORE — CLEAN CIRCULAR START
     ------------------------------------------------------------ */

  .aiCore {
    width: 124px !important;

    height: 124px !important;

    left: 50% !important;

    top: 48px !important;

    transform:
      translateX(-50%) !important;

    border-radius: 50% !important;

    box-shadow:
      0 0 0 9px rgba(118,80,245,.075),
      0 0 0 20px rgba(118,80,245,.045),
      0 18px 55px rgba(83,57,195,.25) !important;
  }


  /* ------------------------------------------------------------
     AI MATCHING LABEL
     ------------------------------------------------------------ */

  .aiLabel {
    top: 422px !important;

    left: 50% !important;

    transform:
      translateX(-50%) !important;

    text-align: center !important;

    z-index: 20 !important;
  }


  .aiLabel h3,
  .ai-label h3 {
    font-size: 18px !important;

    margin: 0 !important;
  }


  .aiLabel p,
  .ai-label p {
    margin:
      8px
      auto
      0 !important;

    max-width: 210px !important;

    font-size: 9px !important;

    line-height: 1.5 !important;
  }


  /* ------------------------------------------------------------
     SIGNAL PILLS
     ------------------------------------------------------------ */

  .aiSignals {
    top: 478px !important;

    left: 50% !important;

    transform:
      translateX(-50%) !important;

    width: 270px !important;

    justify-content: center !important;
  }


  /* ------------------------------------------------------------
     SIDE CARDS — SAME BASELINE
     ------------------------------------------------------------ */

  .profilePanel,
  .matchesPanel {
    height: 392px !important;

    box-sizing: border-box !important;

    z-index: 15 !important;
  }


  /* ------------------------------------------------------------
     MAKE THE CENTRAL CIRCLE VISUALLY CONNECT TO CARDS
     ------------------------------------------------------------ */

  .connectors {
    z-index: 8 !important;
  }


  /* subtle glow where connector enters AI */

  .connectors::after {
    content: "";

    position: absolute;

    left: 50%;

    top: 288px;

    width: 10px;

    height: 10px;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    background: #7650f5;

    box-shadow:
      0 0 0 7px rgba(118,80,245,.08),
      0 0 24px rgba(118,80,245,.38);

    pointer-events: none;
  }


  /* ------------------------------------------------------------
     WHY IT WORKS — KEEP CLEARLY BELOW
     ------------------------------------------------------------ */

  .whyCard {
    top: 518px !important;

    z-index: 30 !important;
  }

}


/* ============================================================
   LAPTOP
   ============================================================ */

@media (min-width: 901px) and (max-width: 1180px) {

  .profilePanel {
    top: 78px !important;
  }

  .matchesPanel {
    top: 78px !important;
  }

  .aiArea::after {
    top: 185px;

    width: 210px;

    height: 210px;
  }

}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

  .aiArea::after {
    animation: none !important;
  }

}


/* ============================================================
