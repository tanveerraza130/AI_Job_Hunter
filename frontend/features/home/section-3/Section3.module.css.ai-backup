  }


  .stage > .whyCard .reason {
    height: 48px !important;
    min-height: 48px !important;

    padding: 7px 10px !important;

    grid-template-columns:
      22px
      minmax(0, 1fr)
      14px !important;

    column-gap: 7px !important;

    border-radius: 11px !important;

    transition:
      transform .25s ease,
      border-color .25s ease,
      box-shadow .25s ease !important;
  }


  /* Number */

  .stage > .whyCard .reason > span {
    width: 22px !important;
    height: 22px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 50% !important;

    font-size: 7px !important;
    line-height: 1 !important;
  }


  /* Unique point text */

  .stage > .whyCard .reason > strong {
    display: block !important;

    min-width: 0 !important;
    max-width: 100% !important;

    font-size: 9px !important;
    line-height: 1.15 !important;

    font-weight: 650 !important;

    letter-spacing: -.01em !important;

    white-space: normal !important;

    overflow: hidden !important;

    text-overflow: ellipsis !important;

    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
  }


  /* Check */

  .stage > .whyCard .reason > i {
    width: 14px !important;
    height: 14px !important;

    font-size: 8px !important;

    margin: 0 !important;
  }


  /* ----------------------------------------------------------
     SUBTLE INTERACTION
     ---------------------------------------------------------- */

  .stage > .whyCard .reason:hover {
    transform: translateY(-3px) !important;

    box-shadow:
      0 10px 25px rgba(105, 70, 230, .10) !important;
  }


  .stage > .whyCard .reason:nth-child(2) {
    animation-delay: -.7s !important;
  }

  .stage > .whyCard .reason:nth-child(3) {
    animation-delay: -1.4s !important;
  }

  .stage > .whyCard .reason:nth-child(4) {
    animation-delay: -2.1s !important;
  }

  .stage > .whyCard .reason:nth-child(5) {
    animation-delay: -2.8s !important;
  }


  /* Header readability */

  .stage > .whyCard .whyHeader h3 {
    font-size: 16px !important;
    line-height: 1.1 !important;
  }


  .stage > .whyCard .whyHeader > div > span {
    font-size: 7.5px !important;
    line-height: 1 !important;
    letter-spacing: .14em !important;
  }


  /* Closing statement */

  .stage > .whyCard .whyFooter span,
  .stage > .whyCard .whyFooter strong {
    font-size: 8px !important;
    line-height: 1.15 !important;
  }

}


/* Reduced motion */

@media (prefers-reduced-motion: reduce) {

  .stage > .whyCard .reason {
    animation: none !important;
    transition: none !important;
  }

}


