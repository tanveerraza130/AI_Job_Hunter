     ---------------------------------------------------------- */

  .stage > .whyCard {
    top: 555px !important;

    left: 50% !important;

    width: 760px !important;
    height: 150px !important;
    min-height: 150px !important;

    padding: 17px 22px !important;

    box-sizing: border-box !important;

    overflow: hidden !important;

    transform: translateX(-50%) !important;
  }


  /* ----------------------------------------------------------
     HEADER
     ---------------------------------------------------------- */

  .stage > .whyCard .whyHeader {
    position: relative !important;

    width: 100% !important;
    height: 29px !important;

    margin: 0 0 11px !important;
    padding: 0 !important;

    display: flex !important;

    align-items: center !important;

    gap: 10px !important;
  }


  .stage > .whyCard .whyIcon {
    flex: 0 0 28px !important;

    width: 28px !important;
    height: 28px !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    margin: 0 !important;
  }


  .stage > .whyCard .whyHeader > div {
    min-width: 0 !important;

    height: 29px !important;

    display: flex !important;

    flex-direction: column !important;

    justify-content: center !important;

    gap: 3px !important;
  }


  .stage > .whyCard .whyHeader > div > span {
    margin: 0 !important;

    font-size: 7px !important;

    line-height: 1 !important;

    letter-spacing: .12em !important;
  }


  .stage > .whyCard .whyHeader h3 {
    margin: 0 !important;

    font-size: 15px !important;

    line-height: 1.05 !important;

    letter-spacing: -.025em !important;
  }


  /* ----------------------------------------------------------
     POINTER GRID
     ---------------------------------------------------------- */

  .stage > .whyCard .reasons {
    width: 100% !important;
    height: 50px !important;

    margin: 0 !important;
    padding: 0 !important;

    display: grid !important;

    grid-template-columns:
      repeat(5, minmax(0, 1fr)) !important;

    gap: 8px !important;

    align-items: stretch !important;
  }


  /* ----------------------------------------------------------
     EACH POINTER
     ---------------------------------------------------------- */

  .stage > .whyCard .reason {
    position: relative !important;

    width: 100% !important;
    height: 50px !important;
    min-height: 50px !important;

    margin: 0 !important;

    padding:
      7px
      9px !important;

    box-sizing: border-box !important;

    display: grid !important;

    grid-template-columns:
      18px
      minmax(0, 1fr)
      16px !important;

    column-gap: 6px !important;

    align-items: center !important;

    border-radius: 10px !important;

    overflow: hidden !important;

    animation:
      whyPointerFloat
      5s
      ease-in-out
      infinite !important;
  }


  .stage > .whyCard .reason:nth-child(2) {
    animation-delay: -.8s !important;
  }

  .stage > .whyCard .reason:nth-child(3) {
    animation-delay: -1.6s !important;
  }

  .stage > .whyCard .reason:nth-child(4) {
    animation-delay: -2.4s !important;
  }

  .stage > .whyCard .reason:nth-child(5) {
    animation-delay: -3.2s !important;
  }


  /* NUMBER */

  .stage > .whyCard .reason > span {
    width: 18px !important;

    margin: 0 !important;

    text-align: center !important;

    font-size: 7px !important;

    line-height: 1 !important;
  }


  /* TEXT — controlled two-line layout */

  .stage > .whyCard .reason > strong {
    min-width: 0 !important;
    max-width: 100% !important;

    margin: 0 !important;

    font-size: 8px !important;

    line-height: 1.25 !important;

    font-weight: 650 !important;

    text-align: left !important;

    white-space: normal !important;

    overflow: hidden !important;

    display: -webkit-box !important;

    -webkit-box-orient: vertical !important;

    -webkit-line-clamp: 2 !important;
  }


  /* CHECK */

  .stage > .whyCard .reason > i {
    width: 16px !important;
    height: 16px !important;

    margin: 0 !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    font-size: 7px !important;

    line-height: 1 !important;

    font-style: normal !important;
  }


  /* ----------------------------------------------------------
     FOOTER
     ---------------------------------------------------------- */

  .stage > .whyCard .whyFooter {
    position: absolute !important;

    left: 22px !important;
    right: 22px !important;

    bottom: 7px !important;

    width: auto !important;
    height: 12px !important;

    margin: 0 !important;
    padding: 0 !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 5px !important;

    white-space: nowrap !important;
  }


  .stage > .whyCard .whyFooter span,
  .stage > .whyCard .whyFooter strong {
    margin: 0 !important;

    font-size: 7px !important;

    line-height: 1 !important;
  }


  /* ----------------------------------------------------------
     SUBTLE MOTION
     ---------------------------------------------------------- */

  @keyframes whyPointerFloat {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-2px);
    }
  }

}


@media (prefers-reduced-motion: reduce) {

  .stage > .whyCard .reason {
    animation: none !important;
  }

}


/* ============================================================
