/* =========================================================
   AI JOB HUNTER — AUTH
   Isolated authentication page styles.
   Does not affect landing page or dashboard.
========================================================= */

.page {
  min-height: 100dvh;
  width: 100%;
  display: grid;
  grid-template-columns: 50% 50%;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 78% 22%,
      rgba(126, 69, 174, 0.12),
      transparent 32%
    ),
    #f4f0ea;

  color: #211d25;
}


/* =========================================================
   LEFT SIDE
========================================================= */

.intro {
  position: relative;
  min-width: 0;
  min-height: 100dvh;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 78% 72%,
      rgba(104, 45, 158, 0.42),
      transparent 38%
    ),
    radial-gradient(
      circle at 18% 25%,
      rgba(116, 72, 155, 0.13),
      transparent 30%
    ),
    linear-gradient(
      145deg,
      #0d0a12 0%,
      #100b18 45%,
      #160c24 100%
    );

  color: #fff;
}

.introInner {
  position: relative;
  z-index: 5;

  width: min(100% - 120px, 650px);
  height: 100%;
  margin: 0 auto;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 52px 0 42px;
  box-sizing: border-box;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;

  color: #c8a5f0;

  font-size: 11px;
  font-weight: 750;
  letter-spacing: 0.32em;
  text-transform: uppercase;
}

.brandMark {
  color: #bd8cff;
  font-size: 15px;
}

.introContent {
  margin-top: auto;
  margin-bottom: auto;

  max-width: 620px;
}

.introEyebrow {
  margin-bottom: 22px;

  color: #b994e4;

  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}

.introContent h1 {
  margin: 0;

  max-width: 620px;

  color: #faf8fc;

  font-size: clamp(50px, 4.8vw, 78px);
  font-weight: 560;
  line-height: 0.96;
  letter-spacing: -0.065em;
}

.introContent h1 em {
  display: block;

  margin-top: 6px;

  color: #bd8cff;

  font-family: Georgia, "Times New Roman", serif;
  font-size: 0.96em;
  font-weight: 400;
  font-style: italic;
  letter-spacing: -0.055em;
}

.introRule {
  width: 70px;
  height: 1px;

  margin: 30px 0 20px;

  background: rgba(189, 140, 255, 0.3);
}

.introRule span {
  display: block;

  width: 24px;
  height: 1px;

  background: #bd8cff;
}

.introDescription {
  max-width: 580px;

  margin: 0;

  color: rgba(237, 231, 242, 0.64);

  font-size: 15px;
  line-height: 1.75;
  letter-spacing: -0.01em;
}

.benefits {
  display: flex;
  flex-direction: column;

  margin-top: 38px;

  gap: 19px;
}

.benefit {
  display: grid;
  grid-template-columns: 24px 32px minmax(0, 1fr);
  align-items: start;

  min-height: 43px;
}

.benefitIcon {
  width: 20px;
  height: 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #b77ff2;

  border-left: 1px solid rgba(183, 127, 242, 0.7);
}

.benefitNumber {
  padding-top: 2px;

  color: #9e7bc0;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.2em;
}

.benefitCopy {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.benefitCopy strong {
  color: rgba(255, 255, 255, 0.9);

  font-size: 13px;
  font-weight: 650;
}

.benefitCopy span {
  color: rgba(235, 226, 242, 0.46);

  font-size: 11px;
  line-height: 1.45;
}

.introFooter {
  display: flex;
  align-items: center;
  gap: 11px;

  color: rgba(221, 211, 230, 0.45);

  font-size: 8px;
  font-weight: 650;
  letter-spacing: 0.2em;
}

.introFooter i {
  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: #a66bdd;
}


/* =========================================================
   LEFT DECORATION
========================================================= */

.orbit,
.glow {
  position: absolute;
  pointer-events: none;
}

.orbit {
  border: 1px solid rgba(188, 137, 244, 0.13);
  border-radius: 50%;
}

.orbitOne {
  width: 720px;
  height: 720px;

  right: -330px;
  bottom: -340px;
}

.orbitTwo {
  width: 430px;
  height: 430px;

  right: -210px;
  bottom: -170px;

  border-color: rgba(188, 137, 244, 0.09);
}

.glow {
  border-radius: 50%;
  filter: blur(50px);
}

.glowOne {
  width: 300px;
  height: 300px;

  right: -80px;
  bottom: -60px;

  background: rgba(115, 49, 183, 0.18);
}

.glowTwo {
  width: 180px;
  height: 180px;

  left: -90px;
  top: 38%;

  background: rgba(109, 68, 158, 0.09);
}


/* =========================================================
   RIGHT SIDE
========================================================= */

.authArea {
  position: relative;

  min-width: 0;
  min-height: 100dvh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 30px;

  box-sizing: border-box;

  background:
    radial-gradient(
      circle at 85% 15%,
      rgba(137, 81, 184, 0.12),
      transparent 30%
    ),
    radial-gradient(
      circle at 15% 90%,
      rgba(137, 81, 184, 0.07),
      transparent 28%
    ),
    #f5f1eb;
}

.authPanel {
  position: relative;

  width: min(100%, 650px);
  height: min(calc(100dvh - 52px), 900px);

  box-sizing: border-box;

  padding: 48px 54px;

  overflow: hidden;

  border: 1px solid rgba(255, 255, 255, 0.96);
  border-radius: 28px;

  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(151, 91, 196, 0.09),
      transparent 32%
    ),
    linear-gradient(
      145deg,
      #ffffff 0%,
      #fcfaf8 62%,
      #f8f4f0 100%
    );

  box-shadow:
    0 35px 80px rgba(43, 31, 48, 0.12),
    0 8px 25px rgba(43, 31, 48, 0.05);

  display: flex;
  flex-direction: column;
}

.authPanel::before {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.65),
      transparent 45%
    );
}

.panelGlow {
  position: absolute;

  width: 260px;
  height: 260px;

  right: -120px;
  top: -120px;

  border-radius: 50%;

  background: rgba(151, 91, 196, 0.07);

  filter: blur(20px);

  pointer-events: none;
}


/* =========================================================
   PROGRESS
========================================================= */

.progress {
  position: relative;
  z-index: 2;

  width: 100%;

  display: grid;
  grid-template-columns: auto minmax(35px, 1fr) auto minmax(35px, 1fr) auto;
  align-items: center;

  gap: 12px;

  margin-bottom: 48px;
}

.progressStep {
  display: flex;
  align-items: center;
  gap: 9px;

  white-space: nowrap;

  color: #bbb3bf;
}

.progressStep span {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.progressStep small {
  font-size: 9px;
  font-weight: 650;
  letter-spacing: 0.23em;
}

.progressActive {
  color: #7540a1;
}

.progressLine {
  height: 1px;

  background: #ddd6df;
}

.progressLineActive {
  background: linear-gradient(
    90deg,
    #7e42ad,
    #b77ee0
  );
}


/* =========================================================
   HEADINGS
========================================================= */

.heading,
.profileHeading {
  position: relative;
  z-index: 2;
}

.kicker {
  display: block;

  margin-bottom: 23px;

  color: #76419f;

  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.31em;
  text-transform: uppercase;
}

.heading h2 {
  margin: 0;

  color: #211d25;

  font-size: clamp(40px, 4vw, 58px);
  font-weight: 560;
  line-height: 0.98;
  letter-spacing: -0.06em;
}

.heading p {
  max-width: 570px;

  margin: 20px 0 0;

  color: #817985;

  font-size: 15px;
  line-height: 1.65;
}

.profileHeading {
  margin-bottom: 25px;
}

.profileHeading .kicker {
  margin-bottom: 15px;
}

.profileHeading h2 {
  margin: 0;

  color: #211d25;

  font-size: clamp(34px, 3.3vw, 46px);
  font-weight: 570;
  line-height: 1;
  letter-spacing: -0.055em;
}

.profileHeading p {
  max-width: 590px;

  margin: 13px 0 0;

  color: #817985;

  font-size: 13px;
  line-height: 1.55;
}


/* =========================================================
   GOOGLE
========================================================= */

.googleButton {
  position: relative;
  z-index: 4;

  width: 100%;
  height: 56px;

  flex: 0 0 56px;

  margin-top: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 11px;

  box-sizing: border-box;

  border: 1px solid #d8d2db;
  border-radius: 9px;

  background: #fff;

  color: #29242d;

  font-family: inherit;
  font-size: 14px;
  font-weight: 680;

  cursor: pointer;

  box-shadow:
    0 7px 20px rgba(43, 31, 48, 0.045);

  transition:
    transform 160ms ease,
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.googleButton:hover {
  transform: translateY(-1px);

  border-color: #c6b3d1;

  box-shadow:
    0 13px 28px rgba(43, 31, 48, 0.08);
}

.googleButton:active {
  transform: translateY(0);
}

/*
  CRITICAL:
  Keep Google logo physically constrained.
*/

.googleLogo {
  display: block;

  width: 19px !important;
  height: 19px !important;

  min-width: 19px;
  min-height: 19px;
  max-width: 19px;
  max-height: 19px;

  flex: 0 0 19px;

  object-fit: contain;

  overflow: visible;
}

.googleButton span {
  line-height: 1;
}


/* =========================================================
   DIVIDER
========================================================= */

.divider {
  width: 100%;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  gap: 13px;

  margin: 30px 0 25px;
}

.divider span {
  height: 1px;

  background: #ded8df;
}

.divider small {
  color: #aaa1ad;

  font-size: 9px;
  font-weight: 650;
  letter-spacing: 0.22em;
}


/* =========================================================
   FORM
========================================================= */

.form {
  position: relative;
  z-index: 2;

  display: flex;
  flex-direction: column;

  gap: 9px;
}

.form label {
  color: #4c4550;

  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
}

.inputWrap {
  position: relative;

  width: 100%;
  height: 50px;

  display: flex;
  align-items: center;

  gap: 11px;

  padding: 0 14px;

  box-sizing: border-box;

  border: 1px solid #d9d3dc;
  border-radius: 9px;

  background: rgba(255, 255, 255, 0.85);

  color: #9676aa;

  transition:
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.inputWrap:focus-within {
  border-color: #8c51b4;

  box-shadow:
    0 0 0 3px rgba(126, 64, 165, 0.08);
}

.inputWrap input {
  width: 100%;
  min-width: 0;

  padding: 0;

  border: 0;
  outline: 0;

  background: transparent;

  color: #302a33;

  font-family: inherit;
  font-size: 14px;
}

.inputWrap input::placeholder {
  color: #aaa2ad;
}

.primaryButton {
  position: relative;
  z-index: 3;

  width: 100%;
  min-height: 56px;

  margin-top: 19px;
  padding: 0 19px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  box-sizing: border-box;

  border: 0;
  border-radius: 9px;

  background:
    linear-gradient(
      105deg,
      #58177e 0%,
      #7d3eb0 55%,
      #9559c6 100%
    );

  color: #fff;

  font-family: inherit;
  font-size: 14px;
  font-weight: 700;

  cursor: pointer;

  box-shadow:
    0 15px 28px rgba(102, 47, 139, 0.22);

  transition:
    transform 160ms ease,
    box-shadow 160ms ease;
}

.primaryButton:hover {
  transform: translateY(-1px);

  box-shadow:
    0 18px 34px rgba(102, 47, 139, 0.28);
}

.primaryButton:active {
  transform: translateY(0);
}

.buttonArrow {
  font-size: 26px;
  font-weight: 300;
  line-height: 1;
}


/* =========================================================
   LEGAL
========================================================= */

.legal {
  position: relative;
  z-index: 2;

  margin-top: 15px;

  text-align: center;

  color: #aaa2ad;

  font-size: 8.5px;
  line-height: 1.5;
}

.legal a {
  margin-left: 4px;

  color: #7540a1;

  text-decoration: none;
}

.legal span {
  margin-left: 4px;
}


/* =========================================================
   TRUST STRIP
========================================================= */

.trustStrip {
  position: relative;
  z-index: 2;

  width: 100%;

  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 20px;

  margin-top: auto;
  padding-top: 22px;

  border-top: 1px solid #e6e0e6;
}

.trustItem {
  display: flex;
  align-items: flex-start;

  gap: 10px;

  color: #8652aa;
}

.trustItem svg {
  flex: 0 0 auto;
}

.trustItem div {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.trustItem strong {
  color: #4b434e;

  font-size: 10px;
  font-weight: 700;
}

.trustItem span {
  color: #a49ba6;

  font-size: 8px;
  line-height: 1.4;
}


/* =========================================================
   PASSWORD
========================================================= */

.accountEmail {
  position: relative;
  z-index: 2;

  min-height: 44px;

  display: flex;
  align-items: center;

  gap: 10px;

  margin: 25px 0 18px;
  padding: 0 13px;

  box-sizing: border-box;

  border: 1px solid #ddd7df;
  border-radius: 8px;

  background: #f5f1f6;

  color: #796e7e;

  font-size: 12px;
}

.passwordToggle {
  border: 0;
  background: transparent;

  color: #9271a4;

  cursor: pointer;
}

.error {
  margin: 2px 0;

  color: #a74368;

  font-size: 10px;
}

.securityNote {
  display: flex;
  align-items: flex-start;

  gap: 10px;

  margin-top: auto;
  padding-top: 20px;

  color: #8861a0;
}

.securityNote div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.securityNote strong {
  color: #514853;

  font-size: 10px;
}

.securityNote span {
  color: #a49ba6;

  font-size: 8px;
}


/* =========================================================
   PROFILE
========================================================= */

.profileForm {
  position: relative;
  z-index: 2;

  display: flex;
  flex-direction: column;

  gap: 10px;

  min-height: 0;
}

.fieldGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 12px 16px;
}


.profileForm .fieldGrid {
  align-items: start;
}

.profileForm .inputWrap,
.profileForm .selectWrap,
.profileForm .ctcInput {
  width: 100%;
  box-sizing: border-box;
}

.profileForm .field > label {
  line-height: 1.2;
}

.profileForm .fieldHint {
  white-space: nowrap;
}

.field {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 6px;
}

.field > label {
  display: flex;
  align-items: center;
  gap: 8px;

  min-height: 13px;

  color: #4d4650;

  font-size: 10px;
  font-weight: 700;
}

.fieldBadge {
  color: #7843a1;

  font-size: 8px;
  font-weight: 750;
  letter-spacing: 0.13em;
}

.fieldHint {
  margin-left: auto;

  color: #a49aa7;

  font-size: 7.5px;
  font-weight: 600;
  letter-spacing: 0.05em;
}

.verifiedIcon {
  margin-left: auto;

  color: #7d48a6;
}


/* =========================================================
   SELECT
========================================================= */

.selectWrap {
  position: relative;

  height: 50px;

  display: flex;
  align-items: center;

  box-sizing: border-box;

  border: 1px solid #d9d3dc;
  border-radius: 9px;

  background: rgba(255, 255, 255, 0.86);

  color: #9676aa;
}

.selectWrap:focus-within {
  border-color: #8c51b4;

  box-shadow:
    0 0 0 3px rgba(126, 64, 165, 0.08);
}

.selectIcon {
  position: absolute;
  left: 14px;

  pointer-events: none;
}

.selectWrap select {
  width: 100%;
  height: 100%;

  padding: 0 40px 0 43px;

  appearance: none;

  border: 0;
  outline: 0;

  background: transparent;

  color: #302a33;

  font-family: inherit;
  font-size: 13px;

  cursor: pointer;
}

.selectWrap select:invalid {
  color: #aaa2ad;
}

.selectChevron {
  position: absolute;
  right: 13px;

  color: #817684;

  pointer-events: none;
}


/* =========================================================
   CTC
========================================================= */

.ctcInput {
  height: 50px;

  display: flex;
  align-items: center;

  box-sizing: border-box;

  border: 1px solid #d9d3dc;
  border-radius: 9px;

  background: rgba(255, 255, 255, 0.86);

  overflow: hidden;
}

.ctcInput:focus-within {
  border-color: #8c51b4;

  box-shadow:
    0 0 0 3px rgba(126, 64, 165, 0.08);
}

.ctcInput > span {
  padding-left: 14px;

  color: #8149a9;

  font-size: 15px;
  font-weight: 650;
}

.ctcInput input {
  width: 100%;
  min-width: 0;

  height: 100%;

  padding: 0 8px;

  border: 0;
  outline: 0;

  background: transparent;

  color: #302a33;

  font-family: inherit;
  font-size: 14px;
}

.ctcInput input::placeholder {
  color: #aaa2ad;
}

.ctcInput small {
  padding-right: 14px;

  color: #938894;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.12em;
}


/* =========================================================
   RESUME
========================================================= */

.resumeUpload {
  position: relative;

  min-height: 56px;

  display: flex;
  align-items: center;

  gap: 11px;

  padding: 7px 9px;

  box-sizing: border-box;

  border: 1px dashed #cdbfd3;
  border-radius: 10px;

  background: #fbf9fc;

  cursor: pointer;

  transition:
    border-color 160ms ease,
    background 160ms ease;
}

.resumeUpload:hover {
  border-color: #9462b5;

  background: #faf7fc;
}

.resumeUpload input {
  position: absolute;

  width: 1px;
  height: 1px;

  opacity: 0;
  pointer-events: none;
}

.resumeIcon {
  width: 38px;
  height: 38px;

  flex: 0 0 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background: #f0e9f5;

  color: #8650ac;
}

.resumeText {
  min-width: 0;

  flex: 1;

  display: flex;
  flex-direction: column;

  gap: 3px;
}

.resumeText strong {
  overflow: hidden;

  color: #4b434e;

  font-size: 10px;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.resumeText span {
  color: #9b929e;

  font-size: 8px;
}

.browseButton {
  flex: 0 0 auto;

  padding: 8px 13px;

  border: 1px solid #d4c7da;
  border-radius: 8px;

  background: #fff;

  color: #7540a1;

  font-size: 9px;
  font-weight: 700;
}


/* =========================================================
   PROFILE CTA
========================================================= */

.profileForm .primaryButton {
  margin-top: 1px;
}

.profilePrivacy {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  color: #aaa1ad;

  font-size: 8px;
  line-height: 1.4;
  text-align: center;
}

.profilePrivacy svg {
  flex: 0 0 auto;

  color: #9a6bb6;
}


/* =========================================================
   COMPLETE
========================================================= */

.completeState {
  position: relative;
  z-index: 2;

  height: 100%;

  display: flex;
  flex-direction: column;
  justify-content: center;
}

.completeMark {
  width: 58px;
  height: 58px;

  margin-bottom: 27px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(121, 66, 160, 0.22);
  border-radius: 50%;

  background: #f2eaf7;

  color: #7842a1;
}

.confirmations {
  display: flex;
  flex-direction: column;

  gap: 10px;

  margin-top: 28px;
}

.confirmations > div {
  display: flex;
  align-items: center;

  gap: 11px;

  padding: 12px 13px;

  border: 1px solid #e2dce3;
  border-radius: 9px;

  background: rgba(255, 255, 255, 0.7);
}

.confirmations > div > span {
  width: 23px;
  height: 23px;

  flex: 0 0 23px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #f0e7f5;

  color: #7842a1;
}

.confirmations p {
  margin: 0;

  display: flex;
  flex-direction: column;

  gap: 2px;
}

.confirmations strong {
  color: #453e48;

  font-size: 10px;
}

.confirmations p span {
  color: #9b929f;

  font-size: 8px;
}

.completeState .primaryButton {
