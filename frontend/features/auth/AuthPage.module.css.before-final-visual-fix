/* =========================================================
   SINGLE VIEWPORT — LEFT + RIGHT LOCKED
   ========================================================= */

html,
body {
  height: 100%;
  overflow: hidden;
}

.page {
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
}

.intro,
.authArea {
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
}

.authArea {
  box-sizing: border-box;
}

.authPanel {
  box-sizing: border-box;
  max-height: calc(100vh - 100px);
  overflow: hidden;
}

/* Keep the whole auth composition inside viewport */
.introInner {
  height: 100%;
  max-height: 100vh;
  box-sizing: border-box;
}

/* Prevent content from creating page height */
.introContent {
  max-height: calc(100vh - 170px);
}


/* Login heading — desktop single line */
.loginState .heading h2 {
  white-space: nowrap;
}

/* Mobile — allow natural wrapping */
@media (max-width: 640px) {
  .loginState .heading h2 {
    white-space: normal;
  }
}


/* =========================================================
   MOBILE AUTH — RESPONSIVE ONLY
   Desktop remains unchanged
   ========================================================= */

@media (max-width: 640px) {

  html,
  body {
    overflow-x: hidden;
  }

  .page {
    height: auto;
    min-height: 100svh;
    overflow: visible;
  }

  /* Hide the large desktop brand panel on mobile */
  .intro {
    display: none;
  }

  .authArea {
    width: 100%;
    min-height: 100svh;
    height: auto;

    padding: 16px 12px 24px;

    box-sizing: border-box;
    overflow: visible;

    align-items: center;
  }

  /* Login / Sign-up switch */
  .authNav {
    width: fit-content;

    align-self: flex-end;

    margin: 0 4px 14px 0;

    padding: 4px;
  }

  .authNavButton,
  .authNavActive {
    min-width: 68px;
    min-height: 36px;

    padding: 9px 13px;

    font-size: 12px;
  }

  /* Main card */
  .authPanel {
    width: 100%;
    max-width: 480px;

    max-height: none;

    margin: 0;

    overflow: visible;

    box-sizing: border-box;
  }

  /* Progress */
  .progress {
    width: 100%;
    box-sizing: border-box;

    padding-left: 4px;
    padding-right: 4px;
  }

  .progressStep small {
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .progressStep span {
    font-size: 11px;
  }

  /* Headings */
  .heading {
    width: 100%;
  }

  .heading h2 {
    font-size: clamp(30px, 8vw, 38px);
    line-height: 1.05;

    max-width: 100%;
  }

  .heading p {
    max-width: 100%;
    font-size: 14px;
    line-height: 1.55;
  }

  /* Login heading can naturally wrap on small screens */
  .loginState .heading h2 {
    white-space: normal;
  }

  /* Buttons */
  .googleButton,
  .primaryButton {
    width: 100%;
    box-sizing: border-box;
  }

  /* Inputs */
  .form {
    width: 100%;
  }

  .inputWrap {
    width: 100%;
    box-sizing: border-box;
  }

  .inputWrap input {
    min-width: 0;
  }

  /* Signup trust points */
  .trustStrip {
    margin-top: 24px;

    width: 100%;

    display: grid;
    grid-template-columns: 1fr;

    gap: 12px;
  }

  .trustItem {
    width: 100%;
    box-sizing: border-box;
  }

  /* Login footer */
  .loginSwitch,
  .authSwitch {
    width: 100%;

    flex-wrap: wrap;
    text-align: center;

    line-height: 1.5;
  }

  .legal {
    text-align: center;
    line-height: 1.5;
  }

  /* Completion state */
  .completeState {
    width: 100%;
    box-sizing: border-box;
  }

  .confirmations {
    width: 100%;
  }
}

