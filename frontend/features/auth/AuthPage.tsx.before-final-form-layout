"use client";

import { ChangeEvent, FormEvent, useEffect, useState } from "react";
import {
  BriefcaseBusiness,
  Check,
  ChevronDown,
  FileText,
  Mail,
  MapPin,
  Phone,
  ShieldCheck,
  Sparkles,
  Upload,
  UserRound,
  Zap,
} from "lucide-react";
