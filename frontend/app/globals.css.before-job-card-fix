@import "tailwindcss";

:root{
  --ink:#172033;
  --muted:#66738a;
  --soft:#8b96a8;
  --line:#e3e8f0;
  --line-strong:#d7deea;
  --bg:#f5f7fb;
  --card:#ffffff;
  --purple:#5b3df5;
  --purple-dark:#4b2fe0;
  --purple-soft:#f0edff;
  --green:#12a66a;
  --green-soft:#ecfaf4;
  --blue:#4770c9;
  --blue-soft:#eef5ff;
  --amber:#b87812;
  --amber-soft:#fff8e8;
  --shadow:0 10px 30px rgba(31,45,74,.06);
}

*{box-sizing:border-box}
html{background:var(--bg);scroll-behavior:smooth}
body{
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased;
}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
a{color:inherit}

.app-shell{min-height:100vh;background:var(--bg)}
.app-container{
  width:min(1440px,100%);
  margin:0 auto;
  padding:20px 28px 48px;
}

/* Header */
.app-header{
  height:68px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 18px;
  background:#fff;
  border:1px solid var(--line);
  border-radius:16px;
  box-shadow:var(--shadow);
}
.brand{display:flex;align-items:center;gap:12px;min-width:0}
.brand-mark{
  width:40px;height:40px;border-radius:11px;
  display:grid;place-items:center;color:#fff;
  background:linear-gradient(135deg,#5834ef,#7857ff);
  box-shadow:0 7px 16px rgba(91,61,245,.2);
}
.brand-title{font-size:16px;font-weight:850;line-height:1.1}
.brand-subtitle{font-size:10px;color:var(--soft);margin-top:4px}
.header-actions{display:flex;align-items:center;gap:10px}
.profile-select{
  height:40px;display:flex;align-items:center;gap:7px;
  padding:0 11px;border:1px solid #ddd8ff;border-radius:10px;
  background:#f7f5ff;color:#5139d4;font-size:11px;font-weight:800;
}
.profile-select select{
  border:0;background:transparent;outline:0;color:inherit;
  font-weight:800;font-size:11px;appearance:none;cursor:pointer;
}
.user-chip{
  height:40px;display:flex;align-items:center;gap:8px;
  padding:0 11px;border:1px solid var(--line);border-radius:10px;background:#fff;
}
.user-avatar{
  width:27px;height:27px;border-radius:50%;display:grid;place-items:center;
  background:#5b3df5;color:#fff;
}
.user-label{font-size:10px;color:#536075;font-weight:750}

/* Dashboard hero */
.hero-section{
  display:flex;align-items:flex-end;justify-content:space-between;
  gap:24px;padding:32px 3px 18px;
}
.eyebrow{
  color:#5b42df;font-size:10px;font-weight:850;
  letter-spacing:.12em;text-transform:uppercase;
}
.hero-section h1{
  margin:7px 0 7px;font-size:30px;line-height:1.08;
  letter-spacing:-.035em;font-weight:850;
}
.hero-section p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}
.result-count{
  flex:none;display:flex;align-items:center;gap:5px;
  padding:9px 12px;border:1px solid var(--line);border-radius:9px;
  background:#fff;color:var(--soft);font-size:10px;
}
.result-count strong{color:#4e5a70;font-size:11px}

/* Search */
.search-panel{
  background:#fff;border:1px solid var(--line);border-radius:15px;
  padding:14px;box-shadow:var(--shadow);
}
.search-row{display:flex;gap:10px;align-items:center}
.search-input{
  flex:1;height:46px;display:flex;align-items:center;gap:8px;
  border:1px solid var(--line-strong);border-radius:10px;padding:0 12px;
  color:#8b96a8;background:#fff;
}
.search-input:focus-within{border-color:#a89cff;box-shadow:0 0 0 3px rgba(91,61,245,.07)}
.search-input input{
  flex:1;min-width:0;height:100%;border:0;outline:0;
  font-size:12px;color:var(--ink);background:transparent;
}
.search-input input::placeholder{color:#a1a9b6}
.search-input .icon-button{border:0;width:28px;height:28px}
.filter-toggle{
  height:46px;padding:0 15px;border:1px solid var(--line);
  border-radius:10px;background:#fff;color:#5d687b;
  display:flex;align-items:center;gap:7px;font-size:11px;font-weight:800;
}
.filter-toggle.active{border-color:#d8d0ff;background:#f7f5ff;color:#553bd8}
.filter-count{
  min-width:18px;height:18px;border-radius:50%;display:grid;place-items:center;
  background:#e8e2ff;color:#553bd8;font-size:9px;
}
.rotate-180{transform:rotate(180deg)}
.filter-grid{
  display:grid;grid-template-columns:repeat(5,minmax(0,1fr)) auto;
  gap:10px;margin-top:12px;padding-top:12px;border-top:1px solid #eef1f5;
}
.field{display:flex;flex-direction:column;gap:6px;min-width:0}
.field>span{
  font-size:9px;color:#7d889b;text-transform:uppercase;
  letter-spacing:.08em;font-weight:800;
}
.field input,.field select{
  height:40px;width:100%;border:1px solid var(--line);
  border-radius:9px;background:#fff;padding:0 10px;outline:0;
  color:#526076;font-size:11px;
}
.field input:focus,.field select:focus{border-color:#a89cff;box-shadow:0 0 0 3px rgba(91,61,245,.06)}
.field-with-icon{position:relative}
.field-with-icon svg{position:absolute;left:10px;top:13px;color:#8994a6}
.field-with-icon input{padding-left:31px}
.filter-actions{display:flex;align-items:flex-end;gap:7px}
.ghost-button,.primary-button{
  height:40px;padding:0 13px;border-radius:9px;
  display:flex;align-items:center;gap:6px;font-size:10px;font-weight:800;white-space:nowrap;
}
.ghost-button{border:1px solid var(--line);background:#fff;color:#5c687c}
.primary-button{border:0;background:var(--purple);color:#fff;box-shadow:0 6px 14px rgba(91,61,245,.17)}

/* Stats */
.stats-grid{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
  gap:11px;margin:13px 0;
}
.stat-card{
  min-height:94px;background:#fff;border:1px solid var(--line);
  border-radius:13px;padding:17px 18px;box-shadow:0 5px 18px rgba(31,45,74,.035);
}
.stat-card.emphasis{background:linear-gradient(180deg,#fff,#f7fffb);border-color:#d9efe5}
.stat-label{
  color:#7e899b;font-size:10px;font-weight:800;
  text-transform:uppercase;letter-spacing:.08em;
}
.stat-value{font-size:25px;line-height:1.1;font-weight:850;margin-top:7px;letter-spacing:-.02em}
.stat-hint{font-size:10px;color:#9aa3b1;margin-top:6px}

/* Jobs */
.jobs-section{
  background:#fff;border:1px solid var(--line);border-radius:15px;
  box-shadow:var(--shadow);overflow:hidden;
}
.section-header{
  display:flex;align-items:flex-end;justify-content:space-between;
  gap:20px;padding:18px 20px 13px;
}
.section-header h2{margin:5px 0 3px;font-size:18px;line-height:1.2}
.section-header p{margin:0;color:#8a94a6;font-size:10px}
.sort-pill{
  display:flex;align-items:center;gap:5px;padding:8px 10px;
  border:1px solid var(--line);border-radius:8px;background:#fff;
  color:#8993a5;font-size:9px;
}
.sort-pill strong{color:#4e5a70;font-size:10px}

.job-list-toolbar{
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid var(--line);padding:0 20px;
}
.segmented-tabs{display:flex;align-items:center;gap:3px}
.segment{
  border:0;background:transparent;padding:9px 12px;border-radius:8px;
  color:#7b8698;font-size:10px;font-weight:800;
}
.segment.active{background:var(--purple);color:#fff}
.result-count{font-size:10px;color:#919aaa}
.job-list{display:flex;flex-direction:column}
.job-row{
  display:grid;
  grid-template-columns:30px 54px minmax(0,1fr) 92px 292px;
  gap:14px;align-items:center;
  padding:19px 20px;
  border-bottom:1px solid #edf0f4;
  transition:background .15s ease,box-shadow .15s ease;
}
.job-row:hover{background:#fbfcff}
.job-row:last-child{border-bottom:0}
.job-rank{font-size:10px;color:#a0a9b8;text-align:center;font-weight:800}
.company-logo{
  width:50px;height:50px;border:1px solid #dfe5ee;border-radius:12px;
  background:#fafbfd;display:grid;place-items:center;
  font-size:12px;font-weight:850;color:#46546b;
}
.job-main{min-width:0}
.job-title-line{display:flex;align-items:center;gap:8px;min-width:0}
.job-title{
  font-size:14px;font-weight:850;color:#172033;text-decoration:none;
  line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.job-title:hover{color:#563de6}
.best-match{
  flex:none;font-size:8px;padding:4px 7px;border-radius:5px;
  background:var(--green-soft);color:#0b9860;font-weight:850;letter-spacing:.02em;
}
.company-name{font-size:11px;color:#68758a;margin-top:4px}
.job-meta{
  display:flex;gap:13px;flex-wrap:wrap;margin-top:8px;
  color:#768297;font-size:10px;
}
.job-meta span{display:flex;align-items:center;gap:4px}
.job-meta svg{width:13px;height:13px;color:#8b96a8}
.match-groups{display:grid;gap:6px;margin-top:10px}
.match-line{display:flex;align-items:flex-start;gap:8px;min-width:0}
.match-line>b{
  width:43px;flex:none;color:#8a94a5;font-size:8px;
  text-transform:uppercase;letter-spacing:.07em;padding-top:5px;
}
.skill-row{display:flex;gap:5px;flex-wrap:wrap;min-width:0}
.skill-chip,.tool-chip,.skill-more{
  font-size:9.5px;padding:5px 8px;border-radius:6px;
  line-height:1.15;font-weight:650;white-space:nowrap;
}
.skill-chip{background:#f2efff;color:#5641b8;border:1px solid #e7e1ff}
.tool-chip{background:#eef6ff;color:#3f669f;border:1px solid #deebfb}
.skill-more{background:#f3f4f7;color:#727d90;border:1px solid #e7e9ed}
.skill-empty{font-size:9px;color:#9da6b4;padding-top:5px}
.job-score-col{text-align:center}
.score-ring{
  width:62px;height:62px;border-radius:50%;display:flex;
  align-items:baseline;justify-content:center;align-content:center;flex-wrap:wrap;
  border:3px solid currentColor;margin:auto;
}
.score-ring strong{font-size:17px;line-height:1}
.score-ring span{font-size:9px}
.score-ring.score-high{color:#0da469;background:#effaf5}
.score-ring.score-good{color:#5870d4;background:#f2f5ff}
.score-ring.score-mid{color:#bd7b17;background:#fff8ec}
.score-ring.score-low,.score-ring.score-neutral{color:#98a1af;background:#f7f8fa}
.job-score-col small{display:block;font-size:9px;color:#8993a4;margin-top:5px}
.job-actions{
  display:flex;align-items:center;justify-content:flex-end;
  gap:7px;flex-wrap:wrap;
}
.icon-button{
  width:34px;height:34px;border:1px solid var(--line);background:#fff;
  color:#8490a2;border-radius:8px;display:grid;place-items:center;
}
.icon-button:hover,.icon-button.active{border-color:#cfc7ff;color:#573ddd;background:#faf9ff}
.status-select{
  height:34px;border:1px solid var(--line);border-radius:8px;
  background:#fff;color:#596579;font-size:10px;padding:0 8px;min-width:96px;
}
.details-link{
  height:34px;display:flex;align-items:center;gap:3px;color:#5540d5;
  font-size:10px;font-weight:850;text-decoration:none;padding:0 5px;white-space:nowrap;
}
.apply-button{
  height:34px;display:flex;align-items:center;gap:4px;padding:0 12px;
  border-radius:8px;background:var(--purple);color:#fff;text-decoration:none;
  font-size:10px;font-weight:850;white-space:nowrap;
  box-shadow:0 5px 12px rgba(91,61,245,.16);
}
.apply-button:hover{background:var(--purple-dark)}
.pagination{
  display:flex;align-items:center;justify-content:space-between;
  border-top:1px solid var(--line);padding:13px 20px;
}
.pagination-button{
  height:34px;padding:0 13px;border:1px solid var(--line);background:#fff;
  border-radius:8px;color:#596478;font-size:10px;font-weight:800;
}
.pagination-button:disabled{opacity:.35;cursor:not-allowed}
.pagination-info{font-size:10px;color:#8993a4}
.pagination-info strong{color:#566277}
.empty-state,.loading-card,.error-card{
  background:#fff;border:1px solid var(--line);border-radius:15px;
  box-shadow:var(--shadow);
}
.empty-state{padding:60px;text-align:center;color:#778397;font-size:13px}
.loading-card{
  margin-top:30px;padding:42px;display:flex;align-items:center;justify-content:center;gap:13px;
}
.loading-spinner{
  width:24px;height:24px;border:3px solid #e5e1ff;border-top-color:var(--purple);
  border-radius:50%;animation:spin .8s linear infinite;
}
.loading-title{font-size:14px;font-weight:800}
.loading-copy{font-size:11px;color:#8b95a7;margin-top:3px}
@keyframes spin{to{transform:rotate(360deg)}}

/* Job detail */
.detail-shell{
  width:min(1360px,100%);margin:0 auto;padding:20px 28px 60px;
}
.back-link{
  display:inline-flex;align-items:center;gap:6px;color:#5e6b80;
  text-decoration:none;font-size:11px;font-weight:800;margin:2px 0 13px;
}
.back-link:hover{color:#5138db}
.detail-hero{
  background:#fff;border:1px solid var(--line);border-radius:17px;padding:24px 26px;
  display:flex;justify-content:space-between;gap:28px;box-shadow:var(--shadow);
}
.hero-info{min-width:0}
.detail-kicker{display:flex;gap:7px;align-items:center;margin-bottom:9px}
.match-label{
  font-size:9px;padding:5px 8px;border-radius:6px;
  background:var(--green-soft);color:#078d59;font-weight:850;
}
.portal-label{
  font-size:9px;padding:5px 8px;border-radius:6px;
  background:#f1f3f7;color:#69758a;font-weight:800;
}
.detail-title{font-size:34px;letter-spacing:-.04em;margin:0;line-height:1.1}
.detail-company{font-size:12px;color:#667288;margin-top:7px;font-weight:650}
.detail-meta{display:flex;gap:16px;flex-wrap:wrap;margin-top:12px;color:#738096;font-size:10px}
.detail-meta span{display:flex;align-items:center;gap:5px}
.hero-right{display:flex;align-items:center;gap:17px}
.hero-score{display:flex;align-items:center;gap:10px;min-width:145px}
.hero-score-ring{
  width:74px;height:74px;border-radius:50%;border:4px solid #15a76b;
  color:#10945d;background:#effaf5;display:flex;align-items:baseline;
  justify-content:center;align-content:center;flex-wrap:wrap;
}
.hero-score-ring strong{font-size:22px;line-height:1}
.hero-score-ring span{font-size:9px}
.hero-score small{display:block;color:#8a94a8;font-size:8px;letter-spacing:.08em;font-weight:850}
.hero-score b{display:block;font-size:19px;margin-top:3px}
.hero-actions{display:flex;align-items:center;gap:7px}
.save-job,.apply-now{
  height:40px;padding:0 14px;border-radius:9px;font-size:10px;
  font-weight:850;white-space:nowrap;
}
.save-job{
  background:#fff;border:1px solid var(--line);color:#596478;
  display:flex;align-items:center;gap:6px;
}
.save-job:hover,.save-job.saved{border-color:#cfc7ff;color:#573ddd;background:#faf9ff}
.apply-now{
  background:var(--purple);color:#fff;text-decoration:none;
  display:inline-flex;align-items:center;gap:6px;box-shadow:0 6px 14px rgba(91,61,245,.18);
}
.apply-now:hover{background:var(--purple-dark)}
.hero-status{height:40px}
.detail-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:11px 0}
.fact-card{
  background:#fff;border:1px solid var(--line);border-radius:11px;padding:14px 16px;
}
.fact-card span{
  font-size:8px;color:#8993a4;text-transform:uppercase;letter-spacing:.09em;font-weight:800;
}
.fact-card strong{display:block;font-size:12px;margin-top:5px}
.detail-grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:14px;align-items:start}
.content-card,.side-card{background:#fff;border:1px solid var(--line);border-radius:15px}
.content-card{padding:22px}
.side-card{padding:18px;position:sticky;top:14px;box-shadow:0 6px 20px rgba(31,45,74,.035)}
.tabs{
  display:flex;gap:3px;border-bottom:1px solid var(--line);
  margin:-22px -22px 21px;padding:0 11px;
}
.tab{
  border:0;background:transparent;padding:15px 13px;color:#8a94a8;
  font-size:10px;font-weight:800;border-bottom:2px solid transparent;
}
.tab.active{color:#583fe4;border-bottom-color:#583fe4}
.section-heading h2{font-size:19px;margin:0}
.section-heading p{margin:5px 0 18px;color:#8a94a8;font-size:10px}
.overview-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.info-box{
  border:1px solid var(--line);background:#fafbfc;border-radius:10px;padding:12px 13px;
}
.info-box span{
  display:block;color:#8c96a8;font-size:8px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;
}
.info-box strong{display:block;font-size:11px;margin-top:5px}
.section-block{margin-top:23px}
.section-block>h3{font-size:13px;margin:0 0 11px}
.description{font-size:12px;line-height:1.8;color:#465268}
.description p{margin:0 0 11px}
.description p:last-child{margin-bottom:0}
.match-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.match-box{border:1px solid var(--line);border-radius:11px;padding:14px}
.match-box.green{background:#f1fbf6;border-color:#d5eee0}
.match-box.blue{background:#f2f6ff;border-color:#dfe6fb}
.match-box.amber{background:#fff9ed;border-color:#f0dfb7}
.match-box-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.match-box h4{font-size:11px;margin:0}
.match-box-title>span,.count-badge{
  font-size:8px;color:#7f8a9c;background:#fff;border:1px solid var(--line);
  border-radius:99px;padding:3px 7px;
}
.chips{display:flex;flex-wrap:wrap;gap:5px}
.chip{
  font-size:9px;border:1px solid #e0e5ec;border-radius:6px;background:#fff;
  padding:5px 8px;color:#536078;line-height:1.2;
}
.chip.skill{background:#f5f2ff;border-color:#e4ddff;color:#5643b8}
.chip.tool{background:#eef7ff;border-color:#dceafb;color:#3f669e}
.chip.strength{display:inline-flex;align-items:center;gap:4px;background:#effaf5;color:#168759}
.empty-inline{font-size:9px;color:#929baa}
.side-section{border-top:1px solid var(--line);margin-top:18px;padding-top:17px}
.side-section.first-side{border-top:0;margin-top:0;padding-top:0}
.side-section h3{font-size:13px;margin:0 0 4px}
.application-sub{font-size:9px;color:#8a94a8;margin:0 0 10px}
.status-list{display:grid;gap:6px}
.status-btn{
  height:36px;border:1px solid var(--line);background:#fff;border-radius:8px;
  padding:0 11px;display:flex;align-items:center;gap:7px;font-size:9px;
  color:#596478;font-weight:800;text-align:left;
}
.status-btn:hover{border-color:#d6ceff;background:#faf9ff}
.status-btn span{width:15px;height:15px;display:grid;place-items:center;color:#573de1}
.status-btn.active{background:#f1eeff;border-color:#d9d1ff;color:#5238d8}
.notes{
  width:100%;min-height:106px;border:1px solid var(--line);border-radius:8px;
  padding:10px;font-size:10px;resize:vertical;outline:none;margin-top:9px;color:var(--ink);
}
.notes:focus{border-color:#a89cff;box-shadow:0 0 0 3px rgba(91,61,245,.06)}
.save-notes{
  width:100%;margin-top:7px;height:35px;border:0;border-radius:8px;
  background:#172033;color:#fff;font-size:9px;font-weight:850;
}
.side-heading{display:flex;align-items:center;justify-content:space-between}
.side-heading span{font-size:8px;color:#9aa3b1}
.scorebar{margin-top:12px}
.scorebar>div{display:flex;justify-content:space-between;font-size:9px;color:#69758a;margin-bottom:5px}
.scorebar b{color:#303b50}
.scorebar i{display:block;height:7px;background:#edf0f5;border-radius:99px;overflow:hidden}
.scorebar em{display:block;height:100%;background:linear-gradient(90deg,#6a4dff,#5b3df5);border-radius:99px}
.count-badge{margin-left:4px}
.error-card{max-width:600px;margin:60px auto;padding:40px;text-align:center}
.error-card h2{margin:0 0 18px}

/* Responsive */
@media(max-width:1180px){
  .app-container,.detail-shell{padding-left:18px;padding-right:18px}
  .job-row{grid-template-columns:26px 50px minmax(0,1fr) 80px 250px;gap:10px}
  .job-actions{gap:5px}
  .filter-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  .detail-grid{grid-template-columns:minmax(0,1fr) 310px}
