  font-size: 11px !important;
  font-weight: 800 !important;

  box-shadow: 0 5px 12px rgba(80, 58, 230, .20) !important;
}

.apply-button:hover {
  background: linear-gradient(135deg, #4933df, #3926c9) !important;
  transform: translateY(-1px) !important;
}

/* ============================================================
   LARGE DESKTOP
   ============================================================ */

@media (min-width: 1400px) {

  .job-row {
    grid-template-columns: 40px 62px minmax(0, 1fr) 105px 205px !important;
    min-height: 205px !important;
    padding: 26px 28px !important;
    column-gap: 20px !important;
  }

  .company-logo {
    width: 58px !important;
    height: 58px !important;
  }

  .job-title {
    font-size: 19px !important;
  }

  .company-name {
    font-size: 13px !important;
  }

  .job-meta {
    font-size: 12px !important;
  }

  .skill-chip,
  .tool-chip,
  .skill-more {
    min-height: 26px !important;
    padding: 5px 10px !important;
    font-size: 10px !important;
  }

  .score-ring {
    width: 78px !important;
    height: 78px !important;
    min-width: 78px !important;
    min-height: 78px !important;
  }

  .score-ring strong {
    font-size: 20px !important;
  }

  .job-actions {
    padding-left: 22px !important;
  }
}

/* ============================================================
   TABLET
   ============================================================ */

@media (max-width: 1100px) and (min-width: 701px) {

  .job-row {
    grid-template-columns: 30px 50px minmax(0, 1fr) 82px 165px !important;
    min-height: 175px !important;
    padding: 18px !important;
    column-gap: 13px !important;
  }

  .job-title {
    font-size: 15px !important;
  }

  .job-meta {
    gap: 5px 10px !important;
    font-size: 10px !important;
  }

  .skill-chip,
  .tool-chip,
  .skill-more {
    font-size: 8.5px !important;
    min-height: 22px !important;
    padding: 4px 7px !important;
  }

  .score-ring {
    width: 62px !important;
    height: 62px !important;
    min-width: 62px !important;
    min-height: 62px !important;
  }

  .job-actions {
    padding-left: 12px !important;
  }
}

/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 700px) {

  .job-list {
    gap: 10px !important;
  }

  .job-row {
    display: grid !important;

    grid-template-columns: 40px minmax(0, 1fr) 66px !important;

    min-height: 0 !important;

    padding: 18px !important;

    column-gap: 10px !important;
    row-gap: 12px !important;
  }

  .job-rank {
    grid-column: 1 !important;
    grid-row: 1 !important;
  }

  .company-logo {
    grid-column: 1 !important;
    grid-row: 2 !important;

    width: 40px !important;
    height: 40px !important;
  }

  .job-main {
    grid-column: 2 !important;
    grid-row: 1 / span 2 !important;
  }

  .job-score-col {
    grid-column: 3 !important;
    grid-row: 1 / span 2 !important;

    border-left: 0 !important;
  }

  .job-actions {
    grid-column: 1 / span 3 !important;
    grid-row: 3 !important;

    flex-direction: row !important;

    padding-left: 0 !important;
    padding-top: 12px !important;

    border-left: 0 !important;
    border-top: 1px solid #edf0f4 !important;
  }

  .status-select {
    flex: 1 !important;
  }

  .details-link {
    width: auto !important;
    padding: 0 8px !important;
  }

  .apply-button {
    width: auto !important;
    padding: 0 18px !important;
  }

  .match-line > b {
    flex-basis: 40px !important;
  }

  .skill-chip,
  .tool-chip,
  .skill-more {
    font-size: 8px !important;
  }
}

/* ============================================================
   AI JOB HUNTER — JOB MARKET
   FINAL SPACING / ALIGNMENT VERSION
   ============================================================ */

.mj-wrapper {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}


/* ============================================================
   TABS
   ============================================================ */

.mj-tabs {
  display: flex;
  align-items: center;
  gap: 6px;

  margin: 0 0 14px;
}

.mj-tab {
  height: 36px;

  padding: 0 16px;

  border: 0;
  border-radius: 9px;

  background: transparent;

  color: #737e90;

  font-size: 13px;
  font-weight: 700;

  cursor: pointer;
}

.mj-tab:hover {
  background: #f4f2ff;
  color: #5140df;
}

.mj-tab-active {
  background: #5540eb;
  color: #ffffff;

  box-shadow:
    0 4px 12px rgba(85, 64, 235, .18);
}


/* ============================================================
   JOB LIST
   ============================================================ */

.mj-list {
  width: 100%;
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 14px;
}


/* ============================================================
   JOB CARD
   55% DETAILS
   30% SCORE
   15% ACTIONS
   ============================================================ */

.mj-card {
  display: grid;

  grid-template-columns:
    minmax(0, 55%)
    minmax(0, 30%)
    minmax(0, 15%);

  width: 100%;
  min-width: 0;
  min-height: 290px;

  padding: 0;
  margin: 0;

  position: relative;

  box-sizing: border-box;

  overflow: hidden;

  background: #ffffff;

  border: 1px solid #dfe5ee;
  border-radius: 16px;

  box-shadow:
    0 1px 2px rgba(20, 30, 50, .025),
    0 6px 18px rgba(30, 40, 70, .035);

  transition:
    border-color .18s ease,
    box-shadow .18s ease,
    transform .18s ease;
}

.mj-card:hover {
  border-color: #d4cdfd;

  box-shadow:
    0 2px 4px rgba(20, 30, 50, .03),
    0 14px 32px rgba(40, 30, 100, .075);

  transform: translateY(-1px);
}


/* ============================================================
   55% — JOB DETAILS
   ============================================================ */

.mj-job-details {
  min-width: 0;

  display: grid;

  grid-template-columns:
    44px
    minmax(0, 1fr);

  align-items: start;

  gap: 16px;

  padding: 30px 28px 30px 26px;

  box-sizing: border-box;

  overflow: hidden;
}

.mj-rank {
  padding-top: 7px;

  color: #8f99aa;

  font-size: 13px;
  line-height: 1;

  font-weight: 800;

  text-align: center;
}

.mj-content {
  min-width: 0;

  display: flex;
  flex-direction: column;

  padding: 0;
}

.mj-title-row {
  min-width: 0;

  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 9px;
}

.mj-title {
  min-width: 0;

  color: #172033;

  font-size: 22px;
  line-height: 1.25;

  font-weight: 780;

  letter-spacing: -.4px;

  text-decoration: none;
}

.mj-title:hover {
  color: #4e3de0;
}

.mj-best {
  flex: 0 0 auto;

  height: 24px;

  display: inline-flex;
  align-items: center;

  padding: 0 10px;

  border: 1px solid #ccebdc;
  border-radius: 999px;

  background: #eaf9f1;

  color: #07865a;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: .7px;
}

.mj-company {
  margin-top: 7px;

  color: #566276;

  font-size: 15px;
  line-height: 1.25;

  font-weight: 650;
}

.mj-meta {
  min-width: 0;

  display: flex;
  align-items: center;
  flex-wrap: wrap;

  margin-top: 15px;

  color: #687487;

  font-size: 12px;
  line-height: 1.2;
}

.mj-meta span {
  display: inline-flex;
  align-items: center;

  gap: 6px;

  min-width: 0;

  white-space: nowrap;
}

.mj-meta span + span::before {
  content: "•";

  margin: 0 11px;

  color: #c1c7d1;

  font-size: 10px;
}

.mj-meta svg {
  flex: 0 0 auto;

  color: #8f99a9;
}


/* ============================================================
   EVIDENCE
   ============================================================ */

.mj-evidence {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 12px;

  margin-top: 20px;

  padding: 16px 17px;

  box-sizing: border-box;

  border: 1px solid #e1e5ec;
  border-radius: 14px;

  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #fbfcff 100%
    );

  overflow: hidden;
}

.mj-evidence-row {
  min-width: 0;

  display: grid;

  grid-template-columns:
    60px
    minmax(0, 1fr);

  align-items: start;

  gap: 11px;
}

.mj-label {
  padding-top: 7px;

  color: #8490a3;

  font-size: 10px;
  line-height: 1;

  font-weight: 850;

  letter-spacing: 1px;
}

.mj-chips {
  min-width: 0;

  display: flex;
  flex-wrap: wrap;

  gap: 7px;
}

.mj-chip,
.mj-more {
  min-height: 29px;

  display: inline-flex;
  align-items: center;

  padding: 6px 10px;

  box-sizing: border-box;

  border-radius: 8px;

  font-size: 10px;
  line-height: 1;

  font-weight: 650;

  white-space: nowrap;
}

.mj-chip-skill {
  border: 1px solid #ded7ff;

  background: #f7f4ff;

  color: #5546a7;
}

.mj-chip-tool {
  border: 1px solid #d5e5f7;

  background: #f3f8fd;

  color: #45698f;
}

.mj-more {
  border: 1px solid #dfe3e9;

  background: #f7f8fa;

  color: #6d7787;
}


/* ============================================================
   30% — SCORE PANEL
   ============================================================ */

.mj-score-panel {
  min-width: 0;
  min-height: 0;

  display: grid;

  /*
    IMPORTANT:
    Circle gets less width.
    Breakdown gets most of the score panel.
  */

  grid-template-columns:
    minmax(82px, 30%)
    minmax(0, 70%);

  box-sizing: border-box;

  /*
    ONLY separator between Job Details and Score.
  */
  border-left: 1px solid #e1e6ed;

  background: #ffffff;

  overflow: hidden;
}


/* ============================================================
   SCORE SUMMARY
   ============================================================ */

.mj-score-summary {
  min-width: 0;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  padding: 18px 5px;

  box-sizing: border-box;

  overflow: hidden;
}


/* ============================================================
   SMALLER SCORE CIRCLE
   ============================================================ */

.mj-score {
  width: 76px;
  height: 76px;

  min-width: 76px;
  min-height: 76px;

  flex: 0 0 76px;

  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;

  border: 3px solid;
  border-radius: 50%;
}

.mj-score strong {
  font-size: 25px;
  line-height: 1;

  font-weight: 850;

  letter-spacing: -1px;
}

.mj-score span {
  margin: 2px 0 0 2px;

  font-size: 10px;
  line-height: 1;

  font-weight: 800;
}

.mj-score-high {
  border-color: #10aa74;

  background: #eefaf5;

  color: #079963;
}

.mj-score-good {
  border-color: #6878e8;

  background: #f4f5ff;

  color: #5363d3;
}

.mj-score-mid {
  border-color: #dfa14a;

  background: #fff9ef;

  color: #b97818;
}

.mj-score-low,
.mj-score-neutral {
  border-color: #b7bec9;

  background: #f7f8fa;

  color: #7e8795;
}

.mj-score-label {
  margin-top: 15px;

  color: #079963;

  font-size: 8px;
  line-height: 1;

  font-weight: 850;

  letter-spacing: 2.3px;

  white-space: nowrap;
}


/* ============================================================
   SCORE BREAKDOWN
   ============================================================ */

.mj-score-breakdown {
  min-width: 0;
  min-height: 0;

  display: flex;
  flex-direction: column;

  /*
    NO BORDER HERE.
    This removes the unwanted line between
    the circle and score breakdown.
  */

  border-left: 0;

  padding: 27px 18px 20px 20px;

  box-sizing: border-box;

  overflow: hidden;
}


/* ============================================================
   SCORE BREAKDOWN TITLE
   ============================================================ */

.mj-breakdown-title {
  flex: 0 0 auto;

  margin: 0 0 27px;

  color: #65748d;

  font-size: 12px;
  line-height: 1.15;

  font-weight: 850;

  letter-spacing: 2.8px;

  text-transform: uppercase;

  white-space: nowrap;
}


/* ============================================================
   METRICS
   ============================================================ */

.mj-score-metrics {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 24px;
}

.mj-score-metric {
  min-width: 0;

  display: grid;

  /*
    LABEL | VALUE | BAR

    Breakdown now has enough width to keep
    full metric names visible.
  */

  grid-template-columns:
    minmax(95px, 1.35fr)
    48px
    minmax(70px, 1fr);

  align-items: center;

  gap: 9px;

  box-sizing: border-box;
}

.mj-score-metric-label {
  min-width: 0;

  color: #687890;

  font-size: 12px;
  line-height: 1.2;

  font-weight: 650;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}

.mj-score-metric-value {
  width: 48px;
  min-width: 48px;

  color: #1c2940;

  font-size: 14px;
  line-height: 1;

  font-weight: 850;

  text-align: right;

  white-space: nowrap;
}

.mj-score-progress {
  width: 100%;
  min-width: 0;
  max-width: 100%;

  height: 9px;

  margin: 0;
  padding: 0;

  box-sizing: border-box;

  border-radius: 999px;

  background: #e7ecef;

  overflow: hidden;
}

.mj-score-progress-fill {
  width: 0;
  max-width: 100%;
  height: 100%;

  display: block;

  margin: 0;
  padding: 0;

  box-sizing: border-box;

  border-radius: 999px;

  background: #1aa976;

  transition: width .25s ease;
}


/* ============================================================
   OVERALL SCORE
   ============================================================ */

.mj-score-overall {
  min-width: 0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin-top: auto;

  padding-top: 19px;

  border-top: 2px solid #e1e6ed;
}

.mj-score-overall span {
  min-width: 0;

  color: #26344c;

  font-size: 15px;
  line-height: 1.15;

  font-weight: 800;

  white-space: nowrap;
}

.mj-score-overall strong {
  flex: 0 0 auto;

  color: #079963;

  font-size: 25px;
  line-height: 1;

  font-weight: 850;

  letter-spacing: -1px;

  white-space: nowrap;
}


/* ============================================================
   15% — ACTIONS
   ============================================================ */

.mj-actions {
  min-width: 0;
  min-height: 0;

  position: relative;

  display: flex;
  flex-direction: column;

  align-items: stretch;
  justify-content: center;

  gap: 14px;

  padding: 28px 20px;

  box-sizing: border-box;

  border-left: 1px solid #e1e6ed;

  background: #ffffff;

  overflow: hidden;
}

.mj-save {
  position: absolute;

  top: 18px;
  right: 18px;

  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;

  border: 1px solid #dfe5ed;
  border-radius: 10px;

  background: #ffffff;

  color: #8995a7;

  cursor: pointer;

  box-sizing: border-box;
}

.mj-save:hover,
.mj-save-active {
  border-color: #d7d0ff;

  background: #f5f2ff;

  color: #5140df;
}

.mj-status {
  width: 100%;
  height: 46px;

  min-width: 0;

  padding: 0 12px;

  border: 1px solid #dfe4eb;
  border-radius: 10px;

  background: #ffffff;

  color: #586477;

  font-size: 12px;
  font-weight: 700;

  box-sizing: border-box;
}

.mj-details {
  min-width: 0;
  min-height: 38px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 6px;

  color: #5140df;

  font-size: 13px;
  font-weight: 800;

  text-decoration: none;

