.job-title:hover {
  color: #4d3bea !important;
}

.best-match {
  display: inline-flex !important;
  align-items: center !important;

  height: 21px !important;
  padding: 0 8px !important;

  border-radius: 999px !important;

  background: #e7f8f0 !important;
  border: 1px solid #cef0df !important;

  color: #07865a !important;

  font-size: 8px !important;
  font-weight: 850 !important;
  letter-spacing: .45px !important;
}

/* COMPANY */
.company-name {
  margin-top: 5px !important;

  color: #586579 !important;
  font-size: 12px !important;
  font-weight: 600 !important;
}

/* META */
.job-meta {
  display: flex !important;
  align-items: center !important;
  flex-wrap: wrap !important;

  gap: 7px 18px !important;
  margin-top: 11px !important;

  color: #687487 !important;
  font-size: 11px !important;
  line-height: 1.4 !important;
}

.job-meta span {
  display: inline-flex !important;
  align-items: center !important;
  gap: 5px !important;

  white-space: nowrap !important;
}

.job-meta svg {
  width: 13px !important;
  height: 13px !important;

  color: #8b95a6 !important;
}

/* MATCH EVIDENCE */
.match-groups {
  display: flex !important;
  flex-direction: column !important;

  gap: 7px !important;
  margin-top: 13px !important;
}

.match-line {
  display: flex !important;
  align-items: flex-start !important;

  gap: 10px !important;
  min-width: 0 !important;
}

.match-line > b {
  flex: 0 0 48px !important;

  padding-top: 5px !important;

  color: #8993a3 !important;

  font-size: 8px !important;
  font-weight: 850 !important;

  letter-spacing: .65px !important;
  text-transform: uppercase !important;
}

.skill-row {
  display: flex !important;
  flex-wrap: wrap !important;

  gap: 5px !important;
  min-width: 0 !important;
}

.skill-chip,
.tool-chip,
.skill-more {
  min-height: 24px !important;

  display: inline-flex !important;
  align-items: center !important;

  padding: 4px 9px !important;

  border-radius: 6px !important;

  font-size: 9.5px !important;
  line-height: 1.15 !important;
  font-weight: 600 !important;

  white-space: nowrap !important;
}

.skill-chip {
  background: #f5f2ff !important;
  border: 1px solid #e6dfff !important;
  color: #5041a5 !important;
}

.tool-chip {
  background: #f1f7ff !important;
  border: 1px solid #dce9f8 !important;
  color: #3e638e !important;
}

.skill-more {
  background: #f6f7f9 !important;
  border: 1px solid #e2e5ea !important;
  color: #707a89 !important;
}
.job-score-col {
  height: 100% !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;

  text-align: center !important;

  border-left: 1px solid #edf0f4 !important;
}

.score-ring {
  width: 72px !important;
  height: 72px !important;

  min-width: 72px !important;
  min-height: 72px !important;

  border-width: 3px !important;
  border-radius: 50% !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  background: #f5fcf8 !important;
}

.score-ring strong {
  font-size: 19px !important;
  line-height: 1 !important;
  font-weight: 850 !important;
}

.score-ring span {
  font-size: 9px !important;
  font-weight: 700 !important;
}

.job-score-col small {
  margin-top: 7px !important;

  color: #8993a3 !important;

  font-size: 9px !important;
  font-weight: 700 !important;

  letter-spacing: .4px !important;
  text-transform: uppercase !important;
}

/* ============================================================
   RIGHT ACTION PANEL
   ============================================================ */

.job-actions {
  align-self: stretch !important;

  display: flex !important;
  flex-direction: column !important;

  justify-content: center !important;
  align-items: stretch !important;

  gap: 8px !important;

  padding-left: 18px !important;

  border-left: 1px solid #edf0f4 !important;
}

/* BOOKMARK */
.icon-button {
  position: absolute !important;
  top: 18px !important;
  right: 18px !important;

  width: 30px !important;
  height: 30px !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  padding: 0 !important;

  border: 1px solid #e2e6ed !important;
  border-radius: 8px !important;

  background: #ffffff !important;
  color: #8c96a6 !important;
}

.icon-button.active {
  color: #5140df !important;
  background: #f5f2ff !important;
  border-color: #ddd7ff !important;
}

/* STATUS */
.status-select {
  width: 100% !important;
  height: 38px !important;

  padding: 0 11px !important;

  border: 1px solid #dfe4eb !important;
  border-radius: 8px !important;

  background: #ffffff !important;
  color: #4f5b6d !important;

  font-size: 11px !important;
  font-weight: 650 !important;
}

/* DETAILS */
.details-link {
  width: 100% !important;
  height: 34px !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 4px !important;

  color: #5040dc !important;

  font-size: 11px !important;
  font-weight: 750 !important;

  text-decoration: none !important;
}

/* APPLY */
.apply-button {
  width: 100% !important;
  height: 40px !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 5px !important;

  padding: 0 14px !important;

  border: 0 !important;
  border-radius: 9px !important;

  background: linear-gradient(135deg, #5943f2, #4932df) !important;
