.section {
  width: 100%;
  max-width: 100vw;
  height: 100vh;
  min-height: 720px;

  margin: 0;
  padding: 0;

  overflow: hidden;
  overflow-x: hidden;
  overflow-y: hidden;

  background: #fdfdfe;

  box-sizing: border-box;
}

/* =========================================================
   APPROVED REFERENCE CANVAS
   Reference: 1920 Ã— 1078

   The canvas scales DOWN to the viewport.
   It never becomes wider than the viewport.
   ========================================================= */

.canvas {
  position: absolute;

  top: 50%;
  left: 50%;

  width: min(1920px, 100vw);
  height: min(1078px, 100vh);

  transform: translate(-50%, -50%);

  display: grid;

  /*
     Reference proportions:
     LEFT   â‰ˆ 31%
     CENTER â‰ˆ 38%
     RIGHT  â‰ˆ 31%
  */

  grid-template-columns:
    31%
    38%
    31%;

  box-sizing: border-box;
}

/* =========================================================
   TEMPORARY BLOCKS
   Only for checking geometry.
   ========================================================= */

.leftBlock {
  width: 100%;
  height: 70%;

  align-self: center;

  box-sizing: border-box;

  border: 1px dashed rgba(239, 90, 112, 0.45);
}

.centerBlock {
  width: 100%;
  height: 70%;

  align-self: center;

  box-sizing: border-box;

  border: 1px dashed rgba(101, 57, 237, 0.45);
}

.rightBlock {
  width: 100%;
  height: 70%;

  align-self: center;

  box-sizing: border-box;

  border: 1px dashed rgba(44, 184, 119, 0.45);
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 768px) {
  .section {
    height: auto;
    min-height: 1500px;

    overflow-x: hidden;
    overflow-y: visible;
  }

  .canvas {
    position: relative;

    top: auto;
    left: auto;

    width: 100%;
    height: auto;

    min-height: 1500px;

    margin: 0;
    padding: 35px 20px;

    transform: none;

    display: flex;
    flex-direction: column;

    gap: 30px;

    box-sizing: border-box;
  }

  .leftBlock,
  .centerBlock,
  .rightBlock {
    width: 100%;
    height: 400px;

    flex: none;
  }
}
.leftBlock,
.centerBlock,
.rightBlock {
  transform: translateY(45px);
}
